---
import Base from '@/layouts/Base.astro';
import { tx, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined)?.trim() || '';

const c = tx(lang, {
  es: {
    titulo: 'Contacto',
    intro: 'Escríbeme sobre prácticas, un proyecto o una idea que quieras construir. Respondo en uno o dos días, en español o en inglés.',
    disponible: 'Disponible',
    foto: 'Fabián Rodas en una terraza de Guayaquil',
    practicas: 'Prácticas desde enero de 2027',
    practicasTexto: 'También acepto proyectos pequeños para negocios locales mientras estudio.',
    ubicacion: 'Ubicación',
    zona: 'Guayaquil, Ecuador (UTC−5)',
    form: 'Envíame un mensaje',
    nombre: 'Nombre',
    nombrePh: 'Tu nombre',
    email: 'Email',
    emailPh: 'tu@correo.com',
    motivo: 'Motivo',
    motivos: ['Prácticas o empleo', 'Un proyecto', 'Otra cosa'],
    mensaje: 'Mensaje',
    mensajePh: 'Cuéntame en qué estás pensando',
    privacidad: 'Tu email solo se usa para responderte.',
    enviar: 'Enviar mensaje',
    enviando: 'Enviando…',
    errNombre: 'Escribe tu nombre.',
    errEmail: 'Escribe un email válido, por ejemplo tu@correo.com.',
    errMensaje: 'Escribe un mensaje de al menos 10 caracteres.',
    errResumen: 'Revisa los campos marcados.',
    ok: '¡Gracias! Tu mensaje llegó. Te respondo en uno o dos días.',
    okMailto: 'Se abrió tu app de correo con el mensaje listo. Si no se abrió, escríbeme a hola@fabianrodas.com.',
    errEnvio: 'No se pudo enviar el mensaje. Inténtalo otra vez o escríbeme a hola@fabianrodas.com.',
    asunto: 'Mensaje desde fabianrodas.com',
    faq: 'Preguntas frecuentes',
    faqTexto: 'Lo que suelen preguntarme antes de escribir.',
    preguntas: [
      ['¿Trabajas en remoto?', 'Sí. Estoy en Guayaquil (UTC−5) y puedo coordinar reuniones en horario de América.'],
      ['¿Haces proyectos para negocios?', 'Sí, sitios y paneles pequeños, del diseño al despliegue.'],
      ['¿En qué idioma puedo escribirte?', 'En español o en inglés.'],
    ],
  },
  en: {
    titulo: 'Contact',
    intro: 'Write to me about internships, a project or an idea you want to build. I reply within one or two days, in Spanish or English.',
    disponible: 'Available',
    foto: 'Fabián Rodas on a terrace in Guayaquil',
    practicas: 'Internships from January 2027',
    practicasTexto: 'I also take small projects for local businesses while I study.',
    ubicacion: 'Location',
    zona: 'Guayaquil, Ecuador (UTC−5)',
    form: 'Send me a message',
    nombre: 'Name',
    nombrePh: 'Your name',
    email: 'Email',
    emailPh: 'you@email.com',
    motivo: 'Reason',
    motivos: ['Internship or job', 'A project', 'Something else'],
    mensaje: 'Message',
    mensajePh: "Tell me what you're thinking about",
    privacidad: 'Your email is only used to reply to you.',
    enviar: 'Send message',
    enviando: 'Sending…',
    errNombre: 'Enter your name.',
    errEmail: 'Enter a valid email, for example you@email.com.',
    errMensaje: 'Write a message of at least 10 characters.',
    errResumen: 'Please check the highlighted fields.',
    ok: "Thanks! Your message arrived. I'll reply within one or two days.",
    okMailto: "Your email app opened with the message ready. If it didn't, write to hola@fabianrodas.com.",
    errEnvio: "The message couldn't be sent. Try again or write to hola@fabianrodas.com.",
    asunto: 'Message from fabianrodas.com',
    faq: 'Frequently asked questions',
    faqTexto: 'What people usually ask before writing.',
    preguntas: [
      ['Do you work remotely?', "Yes. I'm in Guayaquil (UTC−5) and can schedule meetings in American time zones."],
      ['Do you build projects for businesses?', 'Yes, small sites and dashboards, from design to deployment.'],
      ['What language can I write in?', 'Spanish or English.'],
    ],
  },
});

const textosJs = {
  nombre: c.errNombre, email: c.errEmail, mensaje: c.errMensaje, resumen: c.errResumen,
  ok: c.ok, okMailto: c.okMailto, error: c.errEnvio, enviando: c.enviando, asunto: c.asunto,
  etiquetas: { nombre: c.nombre, email: c.email, motivo: c.motivo, mensaje: c.mensaje },
};
---
<Base lang={lang} titulo={c.titulo} descripcion={c.intro} seccion="contacto">
  <main id="contenido" class="contenedor contacto">
    <section aria-labelledby="contacto-title" class="cabeza entrada">
      <h1 id="contacto-title" class="h1-pagina">{c.titulo}</h1>
      <p class="cabeza__intro">{c.intro}</p>
    </section>

    <div class="rejilla" data-entra>
      <div class="datos">
        <div class="disp">
          <p class="disp__titulo">{c.practicas}.</p>
          <p class="disp__texto">{c.practicasTexto}</p>
        </div>
        <dl class="canales">
          <div class="canal">
            <dt>{c.email}</dt>
            <dd class="canal__fila">
              <a href={`mailto:${sitio.email}`} class="enlace canal__email">{sitio.email}</a>
              <button type="button" class="canal__copiar" data-copiar={sitio.email} data-copiado={t('emailCopiado')}>
                <span data-etiqueta>{t('copiar')}</span>
              </button>
            </dd>
          </div>
          <div class="canal">
            <dt>LinkedIn</dt>
            <dd><a href={sitio.linkedin} class="enlace" target="_blank" rel="noopener">{sitio.linkedinTexto}</a></dd>
          </div>
          <div class="canal">
            <dt>GitHub</dt>
            <dd><a href={sitio.github} class="enlace" target="_blank" rel="noopener">{sitio.githubTexto}</a></dd>
          </div>
          <div class="canal">
            <dt>{c.ubicacion}</dt>
            <dd>{c.zona}</dd>
          </div>
        </dl>
        <img class="datos__foto" src={sitio.retrato.src} width={sitio.retrato.width} height={sitio.retrato.height} alt={c.foto} loading="lazy" decoding="async" />
      </div>

      <form
        class="form"
        method="post"
        action={endpoint || `mailto:${sitio.email}`}
        enctype={endpoint ? undefined : 'text/plain'}
        aria-labelledby="form-title"
        data-contacto
        data-endpoint={endpoint}
        data-email={sitio.email}
        data-textos={JSON.stringify(textosJs)}
      >
        <h2 id="form-title" class="form__titulo">{c.form}</h2>
        <div class="form__par">
          <div class="campo">
            <label for="f-nombre">{c.nombre}</label>
            <input id="f-nombre" name="nombre" type="text" placeholder={c.nombrePh} autocomplete="name" required aria-describedby="e-nombre" />
            <span id="e-nombre" class="campo__error" data-error="nombre"></span>
          </div>
          <div class="campo">
            <label for="f-email">{c.email}</label>
            <input id="f-email" name="email" type="email" placeholder={c.emailPh} autocomplete="email" required aria-describedby="e-email" />
            <span id="e-email" class="campo__error" data-error="email"></span>
          </div>
        </div>
        <fieldset class="motivos">
          <legend>{c.motivo}</legend>
          <div class="motivos__opciones">
            {c.motivos.map((m, i) => (
              <label class="motivo"><input type="radio" name="motivo" value={m} checked={i === 0} required />{m}</label>
            ))}
          </div>
        </fieldset>
        <div class="campo">
          <label for="f-mensaje">{c.mensaje}</label>
          <textarea id="f-mensaje" name="mensaje" rows="6" placeholder={c.mensajePh} required minlength="10" aria-describedby="e-mensaje"></textarea>
          <span id="e-mensaje" class="campo__error" data-error="mensaje"></span>
        </div>
        <input type="text" name="_gotcha" class="trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form__pie">
          <span class="form__nota">{c.privacidad}</span>
          <button type="submit" class="btn btn--acento form__enviar" data-enviar><span data-texto-enviar>{c.enviar}</span></button>
        </div>
        <p class="estado" role="status" aria-live="polite" data-estado hidden></p>
      </form>
    </div>

    <section aria-labelledby="faq-title" class="faq" data-entra>
      <div class="faq__cabeza">
        <h2 id="faq-title" class="h2-medio">{c.faq}</h2>
        <p class="texto-sec">{c.faqTexto}</p>
      </div>
      <div class="faq__lista" data-entra>
        {c.preguntas.map(([q, a], i) => (
          <details class="pregunta" open={i === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  import { iniciarFormulario } from '@/scripts/formulario';
  iniciarFormulario();
</script>

<style>
  .contacto { padding-bottom: 120px; display: flex; flex-direction: column; gap: 72px; }
  .cabeza { display: flex; flex-direction: column; gap: 20px; max-width: 760px; padding-top: 72px; }
  .cabeza__intro { font-size: var(--t-entrada); line-height: 1.35; }
  .rejilla { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: start; }

  .datos { display: flex; flex-direction: column; gap: 48px; }
  .datos__foto { width: 50%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; background: var(--c-superficie); }
  .disp { display: flex; flex-direction: column; gap: 8px; }
  .disp__titulo { font-size: var(--t-entrada); line-height: 1.25; color: var(--c-acento); }
  .disp__texto { color: var(--c-suave); }
  .canales { display: flex; flex-direction: column; gap: 24px; }
  .canal dt { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .canal dd { overflow-wrap: anywhere; }
  .canal__fila { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .canal__copiar {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 0;
    background: var(--c-superficie-2); color: var(--c-texto); font-size: var(--t-pequeno); cursor: pointer;
  }
  .canal__copiar:hover { background: var(--c-texto); color: var(--c-fondo); }

  .form { display: flex; flex-direction: column; gap: 28px; padding: 48px; background: var(--c-superficie); }
  .form__titulo { font-size: var(--t-entrada); }
  .form__par { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .campo { display: flex; flex-direction: column; gap: 6px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .campo input, .campo textarea {
    padding: 8px 0; border: 0; border-bottom: 2px solid var(--c-borde-campo); border-radius: 0;
    background: transparent; color: var(--c-texto); font-size: var(--t-cuerpo);
  }
  .campo input { min-height: 48px; }
  .campo textarea { resize: vertical; }
  .campo input:focus, .campo textarea:focus { outline: none; border-bottom-color: var(--c-texto); }
  .campo [aria-invalid='true'] { border-bottom-color: #e59a8c; }
  .campo__error { color: #f0a597; font-size: var(--t-pequeno); }
  .campo__error:empty { display: none; }
  .motivos { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 6px; }
  .motivos legend { padding: 0 0 6px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .motivos__opciones { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  .motivo { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; }
  .motivo input { margin: 0; accent-color: var(--c-acento); }
  .motivo:has(input:focus-visible) { outline: 2px solid var(--c-texto); outline-offset: 3px; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; } /* taste-skill-ignore: campo trampa oculto, no es una línea */
  .form__pie { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .form__nota { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .form__enviar[disabled] { opacity: 0.7; cursor: progress; }
  .estado { padding: 16px 20px; background: var(--c-superficie-2); color: var(--c-texto); }
  .estado[hidden] { display: none; }
  .estado[data-tipo='error'] { background: #3a2624; color: #f4d5cf; }

  .faq { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; padding-top: 72px; }
  .faq__cabeza { display: flex; flex-direction: column; gap: 16px; }
  .faq__lista { display: flex; flex-direction: column; gap: 2px; }
  .pregunta { padding: 24px 28px; background: var(--c-superficie); }
  .pregunta summary { display: flex; justify-content: space-between; gap: 24px; cursor: pointer; list-style: none; font-size: var(--t-entrada); line-height: 1.25; }
  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary::after { content: '+'; color: var(--c-secundario); }
  .pregunta[open] summary::after { content: '−'; }
  .pregunta p { margin: 12px 0 0; color: var(--c-suave); }

  @media (max-width: 1040px) {
    .rejilla, .faq { grid-template-columns: 1fr; gap: 48px; }
    .faq { padding-top: 32px; }
  }
  @media (max-width: 760px) {
    .contacto { gap: 48px; padding-bottom: 72px; }
    .cabeza { padding-top: 32px; }
    .form { margin-inline: calc(var(--gutter) * -1); padding: 28px var(--gutter); }
    .datos__foto { width: 100%; }
    .form__par { grid-template-columns: 1fr; }
    .form__enviar { width: 100%; }
    .pregunta { padding: 20px; }
  }
</style>
