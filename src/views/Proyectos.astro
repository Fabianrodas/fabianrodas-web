---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import Icono from '@/components/Icono.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, type Lang } from '@/i18n/ui';
import { obtenerProyectos, type Proyecto } from '@/lib/contenido';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const [principal, ...grid] = destacados;
const otros = proyectos.filter((p) => !p.data.featured);

const contar = (estado: Proyecto['data']['status']) => proyectos.filter((p) => p.data.status === estado).length;

const c = tx(lang, {
  es: {
    titulo: 'Proyectos',
    intro: 'Lo que he construido entre la universidad, clientes y proyectos propios. Los principales tienen su caso de estudio.',
    produccion: (n: number) => `${n} en producción`,
    desarrollo: (n: number) => `${n} en desarrollo`,
    archivados: (n: number) => `${n} ${n === 1 ? 'archivado' : 'archivados'}`,
    filtros: 'Filtros',
    categorias: 'Filtrar por categoría',
    todos: 'Todos',
    web: 'Web',
    escritorio: 'Escritorio',
    cliente: 'Para clientes',
    universidad: 'Universidad',
    buscar: 'Buscar proyecto',
    buscarPh: 'Buscar por nombre o tecnología',
    destacados: 'Proyectos destacados',
    leer: 'Leer el caso de estudio',
    otros: 'Otros proyectos',
    otrosTexto: 'Trabajos de la universidad y experimentos que ya no mantengo.',
    verEn: (t: string) => `Ver ${t} en GitHub`,
    vacioTitulo: 'No hay proyectos con este filtro',
    vacioTexto: 'Prueba con otra categoría o con otra búsqueda.',
    vacioBoton: 'Ver todos los proyectos',
    resultado: (n: number) => (n === 1 ? '1 proyecto' : `${n} proyectos`),
  },
  en: {
    titulo: 'Projects',
    intro: "What I've built across university, clients and my own projects. The main ones have their own case study.",
    produccion: (n: number) => `${n} in production`,
    desarrollo: (n: number) => `${n} in development`,
    archivados: (n: number) => `${n} archived`,
    filtros: 'Filters',
    categorias: 'Filter by category',
    todos: 'All',
    web: 'Web',
    escritorio: 'Desktop',
    cliente: 'For clients',
    universidad: 'University',
    buscar: 'Search projects',
    buscarPh: 'Search by name or technology',
    destacados: 'Featured projects',
    leer: 'Read the case study',
    otros: 'Other projects',
    otrosTexto: "University work and experiments I no longer maintain.",
    verEn: (t: string) => `See ${t} on GitHub`,
    vacioTitulo: 'No projects match this filter',
    vacioTexto: 'Try another category or search.',
    vacioBoton: 'See all projects',
    resultado: (n: number) => (n === 1 ? '1 project' : `${n} projects`),
  },
});

const categorias = [
  { clave: 'todos', label: c.todos, n: proyectos.length },
  ...(['web', 'escritorio', 'cliente', 'universidad'] as const).map((k) => ({
    clave: k,
    label: c[k],
    n: proyectos.filter((p) => p.data.category.includes(k)).length,
  })),
];

const datos = (p: Proyecto) => ({
  'data-proyecto': '',
  'data-categorias': p.data.category.join(' '),
  'data-busqueda': [p.data.title, ...p.data.stack, ...(p.data.tags ?? [])].join(' ').toLowerCase(),
});
const url = (p: Proyecto) => ruta(lang, `/proyectos/${p.data.slug}/`);
const textos = { resultado: [c.resultado(0), c.resultado(1), c.resultado(2)] };
---
<Base lang={lang} titulo={c.titulo} descripcion={c.intro} seccion="proyectos">
  <main id="contenido" class="contenedor pagina">
    <section aria-labelledby="proyectos-title" class="cabeza">
      <div class="cabeza__texto entrada">
        <h1 id="proyectos-title" class="h1-pagina">{c.titulo}</h1>
        <p class="cabeza__intro">{c.intro}</p>
      </div>
      <div class="resumen">
        <span class="resumen__item resumen__item--acento"><span class="punto"></span>{c.produccion(contar('produccion'))}</span>
        <span class="resumen__item resumen__item--amarillo"><span class="punto"></span>{c.desarrollo(contar('desarrollo'))}</span>
        <span class="resumen__item"><span class="punto"></span>{c.archivados(contar('archivado'))}</span>
      </div>
    </section>

    <section aria-label={c.filtros} class="filtros" data-solo-js>
      <div class="filtros__botones" role="group" aria-label={c.categorias}>
        {categorias.map((k, i) => (
          <button type="button" class="filtro" aria-pressed={i === 0 ? 'true' : 'false'} data-categoria={k.clave}>
            {k.label} <span class="filtro__n">{k.n}</span>
          </button>
        ))}
      </div>
      <label class="buscador">
        <Icono nombre="search" size={16} />
        <input type="search" aria-label={c.buscar} placeholder={c.buscarPh} data-buscador />
      </label>
      <p class="sr-only" aria-live="polite" data-resultado data-textos={JSON.stringify(textos)}></p>
    </section>

    <div class="vacio" hidden data-vacio>
      <h2 class="vacio__titulo">{c.vacioTitulo}</h2>
      <p class="texto-sec">{c.vacioTexto}</p>
      <button type="button" class="btn btn--sm btn--acento" data-reiniciar>{c.vacioBoton}</button>
    </div>

    <section aria-label={c.destacados} class="destacados" data-grupo>
      {principal && (
        <a href={url(principal)} class="tarjeta grande revelar" {...datos(principal)}>
          <Shot portada={principal.data.cover} radius="14px" lang={lang} prioridad />
          <div class="grande__cuerpo">
            <div class="chips">
              <ChipEstado estado={principal.data.status} lang={lang} grande />
              {principal.data.version && <span class="chip chip--m">v{principal.data.version}</span>}
              {principal.data.platformShort && <span class="chip chip--m">{principal.data.platformShort}</span>}
            </div>
            <h2 class="grande__titulo">{principal.data.title}</h2>
            <p class="texto-sec">{principal.data.summary}</p>
            <ul class="grande__datos">
              <li><Icono nombre="calendar" size={16} stroke="#9aa099" />{principal.data.year}</li>
              <li><Icono nombre="code" size={16} stroke="#9aa099" />{principal.data.role}</li>
            </ul>
            <div class="chips">{(principal.data.tags ?? principal.data.stack).map((s) => <span class="chip chip--m">{s}</span>)}</div>
            <span class="btn btn--sm btn--acento grande__cta">{c.leer}</span>
          </div>
        </a>
      )}
      <div class="rejilla">
        {grid.map((p) => (
          <a href={url(p)} class="tarjeta media revelar" {...datos(p)}>
            <Shot portada={p.data.cover} radius="14px" lang={lang} />
            <div class="media__cuerpo">
              <div class="media__fila">
                <h2 class="media__titulo">{p.data.title}</h2>
                <ChipEstado estado={p.data.status} lang={lang} grande version={p.data.status === 'desarrollo' ? p.data.version : undefined} />
              </div>
              <p class="texto-sec">{p.data.summary}</p>
              <div class="media__pie">
                <div class="chips">{(p.data.tags ?? p.data.stack).map((s) => <span class="chip chip--m">{s}</span>)}</div>
                <span class="media__anio">{p.data.year}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {otros.length > 0 && (
      <section aria-labelledby="otros-title" class="otros banda banda--pad" data-grupo>
        <div class="seccion-cabecera__texto">
          <h2 id="otros-title" class="h2-medio">{c.otros}</h2>
          <p class="texto-sec">{c.otrosTexto}</p>
        </div>
        <ul class="otros__lista">
          {otros.map((p) => (
            <li class="otro spot" {...datos(p)}>
              <Shot portada={p.data.cover} label={lang === 'es' ? 'Captura' : 'Screenshot'} radius="10px" lang={lang} />
              <span class="otro__texto"><span class="otro__titulo">{p.data.title}</span><span class="otro__desc">{p.data.summary}</span></span>
              <span class="chips otro__stack">{p.data.stack.map((s) => <span class="chip">{s}</span>)}</span>
              <span class="otro__anio">{p.data.year}</span>
              {p.data.links.repo && (
                <a href={p.data.links.repo} class="otro__enlace" aria-label={c.verEn(p.data.title)} target="_blank" rel="noopener">
                  <Icono nombre="arrow-up-right" size={16} />
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>

<script>
  import { iniciarFiltroProyectos } from '@/scripts/filtro-proyectos';
  iniciarFiltroProyectos();
</script>

<style>
  .pagina { padding-bottom: 112px; display: flex; flex-direction: column; gap: 32px; }
  .cabeza { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; padding-top: 56px; }
  .cabeza__texto { display: flex; flex-direction: column; gap: 10px; max-width: 620px; }
  .cabeza__intro { font-size: 17px; color: var(--c-secundario); }
  .resumen { display: flex; gap: 8px; flex-wrap: wrap; font-size: 14px; }
  .resumen__item {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: var(--r-pildora);
    background: var(--c-superficie); color: var(--c-secundario);
  }
  .resumen__item--acento { background: var(--c-fondo-acento); color: var(--c-acento); }
  .resumen__item--amarillo { background: var(--c-fondo-amarillo); color: var(--c-amarillo); }
  .punto { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

  .filtros { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .filtros__botones { display: flex; gap: 6px; flex-wrap: wrap; }
  .filtro {
    height: 40px; padding: 0 16px; border: 0; border-radius: var(--r-pildora); background: var(--c-superficie);
    color: var(--c-texto); font-size: 14px; cursor: pointer;
  }
  .filtro__n { color: var(--c-secundario); }
  .filtro[aria-pressed='true'] { background: var(--c-texto); color: var(--c-fondo); font-weight: 500; }
  .filtro[aria-pressed='true'] .filtro__n { color: inherit; opacity: 0.7; }
  .buscador {
    display: flex; align-items: center; gap: 10px; width: 300px; height: 42px; padding: 0 16px;
    border-radius: var(--r-pildora); background: var(--c-superficie); color: var(--c-secundario);
  }
  .buscador:focus-within { outline: 2px solid var(--c-acento); outline-offset: 3px; }
  .buscador input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--c-texto); font-size: 14px; outline: none; }

  .vacio { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 48px; border-radius: var(--r-l); background: var(--c-superficie); }
  .vacio[hidden] { display: none; }
  .vacio__titulo { font-family: var(--f-titulo); font-size: 22px; font-weight: 600; }

  .destacados { display: flex; flex-direction: column; gap: 20px; }
  [hidden] { display: none !important; }
  .grande {
    display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 36px; align-items: center;
    padding: 10px 36px 10px 10px; border-radius: var(--r-l);
  }
  .grande__cuerpo { display: flex; flex-direction: column; gap: 14px; }
  .grande__titulo { font-family: var(--f-titulo); font-size: 30px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .grande__datos { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .grande__datos li { display: flex; align-items: center; gap: 10px; }
  .grande__cta { align-self: flex-start; margin-top: 6px; font-weight: 500; }

  .rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .media { gap: 18px; padding: 10px 10px 24px; border-radius: var(--r-l); }
  .media__cuerpo { display: flex; flex-direction: column; gap: 10px; padding: 0 14px; }
  .media__fila, .media__pie { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .media__pie { flex-wrap: wrap; }
  .media__titulo { font-family: var(--f-titulo); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
  .media__anio { font-size: 14px; color: var(--c-secundario); }

  .otros { display: flex; flex-direction: column; gap: 20px; padding-top: 48px; }
  .otros__lista { list-style: none; padding: 8px; border-radius: var(--r-l); background: var(--c-superficie); display: flex; flex-direction: column; gap: 4px; }
  .otro {
    display: grid; grid-template-columns: 128px minmax(0, 1fr) minmax(0, 0.9fr) 64px 44px; gap: 24px; align-items: center;
    padding: 10px 14px 10px 10px; border-radius: 16px;
  }
  .otro__texto { display: flex; flex-direction: column; gap: 2px; }
  .otro__titulo { font-size: 17px; font-weight: 500; }
  .otro__desc { font-size: 14px; color: var(--c-secundario); }
  .otro__anio { font-size: 14px; color: var(--c-secundario); }
  .otro__enlace {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--c-superficie-2); color: var(--c-texto);
  }

  @media (max-width: 1040px) {
    .grande { grid-template-columns: 1fr; padding: 10px 10px 24px; gap: 20px; }
    .grande__cuerpo { padding: 0 14px; }
    .otro { grid-template-columns: 112px minmax(0, 1fr) 44px; gap: 16px; }
    .otro__stack, .otro__anio { display: none; }
  }
  @media (max-width: 760px) {
    .pagina { gap: 24px; padding-bottom: 64px; }
    .cabeza { padding-top: 28px; gap: 20px; }
    .cabeza__intro { font-size: 16px; }
    .filtros__botones { flex-wrap: nowrap; overflow-x: auto; margin: 0 -20px; padding: 0 20px 4px; scrollbar-width: none; }
    .filtro { flex: none; height: 44px; }
    .buscador { width: 100%; height: 48px; }
    .rejilla { grid-template-columns: 1fr; gap: 16px; }
    .grande, .media { padding: 8px 8px 18px; border-radius: var(--r-m); }
    .grande__cuerpo, .media__cuerpo { padding: 0 8px; }
    .grande__titulo, .media__titulo { font-size: 22px; }
    .media__fila { flex-wrap: wrap; }
    .otros { padding-top: 24px; }
    .otro { grid-template-columns: 80px minmax(0, 1fr) 44px; gap: 12px; padding: 6px; }
  }
</style>
