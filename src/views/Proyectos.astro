---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, type Lang } from '@/i18n/ui';
import { obtenerProyectos, type Proyecto } from '@/lib/contenido';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const [principal, ...grid] = destacados;
const otros = proyectos.filter((p) => !p.data.featured);

const contar = (estado: Proyecto['data']['status']) => proyectos.filter((p) => p.data.status === estado).length;

const c = tx(lang, {
  es: {
    titulo: 'Proyectos',
    intro: 'Lo que he construido entre la universidad, clientes y proyectos propios. Los principales tienen su caso de estudio.',
    produccion: (n: number) => `${n} en producción`,
    desarrollo: (n: number) => `${n} en desarrollo`,
    archivados: (n: number) => `${n} ${n === 1 ? 'archivado' : 'archivados'}`,
    filtros: 'Filtros',
    categorias: 'Filtrar por categoría',
    todos: 'Todos',
    web: 'Web',
    escritorio: 'Escritorio',
    cliente: 'Para clientes',
    universidad: 'Universidad',
    buscar: 'Buscar proyecto',
    buscarPh: 'Buscar por nombre o tecnología',
    destacados: 'Proyectos destacados',
    leer: 'Leer el caso de estudio',
    otros: 'Otros proyectos',
    otrosTexto: 'Trabajos de la universidad y experimentos que ya no mantengo.',
    verEn: (t: string) => `Ver ${t} en GitHub`,
    vacioTitulo: 'No hay proyectos con este filtro',
    vacioTexto: 'Prueba con otra categoría o con otra búsqueda.',
    vacioBoton: 'Ver todos los proyectos',
    resultado: (n: number) => (n === 1 ? '1 proyecto' : `${n} proyectos`),
  },
  en: {
    titulo: 'Projects',
    intro: "What I've built across university, clients and my own projects. The main ones have their own case study.",
    produccion: (n: number) => `${n} in production`,
    desarrollo: (n: number) => `${n} in development`,
    archivados: (n: number) => `${n} archived`,
    filtros: 'Filters',
    categorias: 'Filter by category',
    todos: 'All',
    web: 'Web',
    escritorio: 'Desktop',
    cliente: 'For clients',
    universidad: 'University',
    buscar: 'Search projects',
    buscarPh: 'Search by name or technology',
    destacados: 'Featured projects',
    leer: 'Read the case study',
    otros: 'Other projects',
    otrosTexto: "University work and experiments I no longer maintain.",
    verEn: (t: string) => `See ${t} on GitHub`,
    vacioTitulo: 'No projects match this filter',
    vacioTexto: 'Try another category or search.',
    vacioBoton: 'See all projects',
    resultado: (n: number) => (n === 1 ? '1 project' : `${n} projects`),
  },
});

const categorias = [
  { clave: 'todos', label: c.todos, n: proyectos.length },
  ...(['web', 'escritorio', 'cliente', 'universidad'] as const).map((k) => ({
    clave: k,
    label: c[k],
    n: proyectos.filter((p) => p.data.category.includes(k)).length,
  })),
];

const datos = (p: Proyecto) => ({
  'data-proyecto': '',
  'data-categorias': p.data.category.join(' '),
  'data-busqueda': [p.data.title, ...p.data.stack, ...(p.data.tags ?? [])].join(' ').toLowerCase(),
});
const url = (p: Proyecto) => ruta(lang, `/proyectos/${p.data.slug}/`);
const textos = { resultado: [c.resultado(0), c.resultado(1), c.resultado(2)] };
---
<Base lang={lang} titulo={c.titulo} descripcion={c.intro} seccion="proyectos">
  <main id="contenido" class="contenedor pagina">
    <section aria-labelledby="proyectos-title" class="cabeza">
      <div class="cabeza__texto entrada">
        <h1 id="proyectos-title" class="h1-pagina">{c.titulo}</h1>
        <p class="cabeza__intro">{c.intro}</p>
        <p class="resumen">{c.produccion(contar('produccion'))}, {c.desarrollo(contar('desarrollo'))}, {c.archivados(contar('archivado'))}.</p>
      </div>
    </section>

    <section aria-label={c.filtros} class="filtros" data-solo-js>
      <div class="filtros__botones" role="group" aria-label={c.categorias}>
        {categorias.map((k, i) => (
          <button type="button" class="filtro" aria-pressed={i === 0 ? 'true' : 'false'} data-categoria={k.clave}>
            {k.label} <span class="filtro__n">{k.n}</span>
          </button>
        ))}
      </div>
      <label class="buscador">
        <span class="sr-only">{c.buscar}</span>
        <input type="search" aria-label={c.buscar} placeholder={c.buscarPh} data-buscador />
      </label>
      <p class="sr-only" aria-live="polite" data-resultado data-textos={JSON.stringify(textos)}></p>
    </section>

    <div class="vacio" hidden data-vacio>
      <h2 class="vacio__titulo">{c.vacioTitulo}</h2>
      <p class="texto-sec">{c.vacioTexto}</p>
      <button type="button" class="btn btn--sm btn--acento" data-reiniciar>{c.vacioBoton}</button>
    </div>

    <section aria-label={c.destacados} class="destacados" data-grupo data-entra>
      {principal && (
        <a href={url(principal)} class="grande" {...datos(principal)}>
          <div class="grande__imagen" data-ui><Shot portada={principal.data.cover} radius="0" lang={lang} prioridad /></div>
          <div class="grande__cuerpo">
            <h2 class="grande__titulo">{principal.data.title}</h2>
            <p class="linea">
              <ChipEstado estado={principal.data.status} lang={lang} version={principal.data.version} />
              {principal.data.platformShort && <span> · {principal.data.platformShort}</span>}
              <span> · {principal.data.year}</span>
            </p>
            <p class="grande__resumen">{principal.data.summary}</p>
            <p class="linea">{principal.data.role}. {(principal.data.tags ?? principal.data.stack).join(', ')}.</p>
            <span class="enlace grande__cta">{c.leer}</span>
          </div>
        </a>
      )}
      <div class="rejilla" data-entra>
        {grid.map((p) => (
          <a href={url(p)} class="media" {...datos(p)}>
            <div class="media__imagen" data-ui><Shot portada={p.data.cover} radius="0" lang={lang} /></div>
            <h2 class="media__titulo">{p.data.title}</h2>
            <p class="linea">
              <ChipEstado estado={p.data.status} lang={lang} version={p.data.status === 'desarrollo' ? p.data.version : undefined} />
              <span> · {(p.data.tags ?? p.data.stack).join(', ')} · {p.data.year}</span>
            </p>
            <p class="media__resumen">{p.data.summary}</p>
          </a>
        ))}
      </div>
    </section>

    {otros.length > 0 && (
      <section aria-labelledby="otros-title" class="otros" data-grupo>
        <div class="otros__cabeza" data-entra>
          <h2 id="otros-title" class="h2-medio">{c.otros}</h2>
          <p class="texto-sec">{c.otrosTexto}</p>
        </div>
        <ul class="otros__lista" data-entra>
          {otros.map((p) => (
            <li class="otro" {...datos(p)}>
              <span class="otro__titulo">{p.data.title}</span>
              <span class="otro__desc">{p.data.summary}</span>
              <span class="otro__stack">{p.data.stack.join(', ')}</span>
              <span class="otro__anio">{p.data.year}</span>
              {p.data.links.repo ? (
                <a href={p.data.links.repo} class="enlace otro__enlace" aria-label={c.verEn(p.data.title)} target="_blank" rel="noopener">GitHub</a>
              ) : <span></span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>

<script>
  import { iniciarFiltroProyectos } from '@/scripts/filtro-proyectos';
  iniciarFiltroProyectos();
</script>

<style>
  .pagina { padding-bottom: 120px; display: flex; flex-direction: column; gap: 48px; }
  .cabeza { padding-top: 72px; }
  .cabeza__texto { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .cabeza__intro { font-size: var(--t-entrada); line-height: 1.35; color: var(--c-texto); }
  .resumen { font-size: var(--t-pequeno); color: var(--c-secundario); }

  .filtros { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .filtros__botones { display: flex; gap: 28px; flex-wrap: wrap; }
  .filtro {
    display: inline-flex; align-items: baseline; gap: 6px; min-height: 44px; padding: 0; border: 0; background: none;
    color: var(--c-secundario); font-size: var(--t-cuerpo); cursor: pointer;
    text-decoration: underline; text-underline-offset: 8px; text-decoration-color: transparent;
  }
  .filtro__n { font-size: var(--t-pequeno); }
  .filtro:hover { color: var(--c-texto); }
  .filtro[aria-pressed='true'] { color: var(--c-texto); text-decoration-color: var(--c-acento); }
  .buscador { display: block; width: 320px; }
  .buscador input {
    width: 100%; min-height: 44px; padding: 0; border: 0; border-bottom: 2px solid var(--c-superficie-2); border-radius: 0;
    background: transparent; color: var(--c-texto); font-size: var(--t-cuerpo); outline: none;
  }
  .buscador input:focus { border-bottom-color: var(--c-texto); }

  .vacio { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 48px; background: var(--c-superficie); }
  .vacio[hidden] { display: none; }
  .vacio__titulo { font-size: var(--t-entrada); }

  [hidden] { display: none !important; }
  .destacados { display: flex; flex-direction: column; gap: 96px; }
  .linea { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .linea :global(.chip) { font-size: inherit; }

  .grande {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: end;
    color: var(--c-texto); text-decoration: none;
  }
  .grande__imagen, .media__imagen { overflow: hidden; background: var(--c-superficie); }
  .grande__cuerpo { display: flex; flex-direction: column; gap: 16px; }
  .grande__titulo { font-size: var(--t-titulo); letter-spacing: -0.03em; line-height: 0.95; }
  .grande__resumen { font-size: var(--t-entrada); line-height: 1.35; }
  .grande__cta { align-self: flex-start; margin-top: 8px; }

  .rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 72px 48px; }
  .media { display: flex; flex-direction: column; gap: 12px; color: var(--c-texto); text-decoration: none; }
  .media__imagen { margin-bottom: 8px; }
  .media__titulo { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); letter-spacing: -0.025em; line-height: 1; }
  .media__resumen { color: var(--c-suave); max-width: 52ch; }
  .grande:hover .grande__titulo, .media:hover .media__titulo { text-decoration: underline; text-underline-offset: 8px; text-decoration-thickness: 2px; text-decoration-color: var(--c-acento); }

  .otros { display: flex; flex-direction: column; gap: 24px; padding-top: 48px; }
  .otros__cabeza { display: flex; flex-direction: column; gap: 12px; }
  .otros__lista { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .otro {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr) minmax(0, 1fr) 64px 72px; gap: 24px; align-items: baseline;
    padding: 20px 24px; background: var(--c-superficie);
  }
  .otro__titulo { font-size: var(--t-entrada); }
  .otro__desc, .otro__stack, .otro__anio { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .otro__desc { color: var(--c-suave); }
  .otro__enlace { font-size: var(--t-pequeno); justify-self: end; display: inline-flex; align-items: center; min-height: 44px; }

  @media (prefers-reduced-motion: no-preference) {
    .grande__imagen :global(.shot__lienzo), .media__imagen :global(.shot__lienzo) { transition: transform 700ms var(--ease-salida); }
    .grande:hover :global(.shot__lienzo), .media:hover :global(.shot__lienzo) { transform: scale(1.03); }
  }

  @media (max-width: 1040px) {
    .grande { grid-template-columns: 1fr; gap: 24px; }
    .otro { grid-template-columns: minmax(0, 1fr) 72px; gap: 8px 16px; }
    .otro__desc { grid-column: 1 / -1; grid-row: 2; }
    .otro__stack, .otro__anio { display: none; }
    .otro__enlace { grid-row: 1; grid-column: 2; }
  }
  @media (max-width: 760px) {
    .pagina { gap: 32px; padding-bottom: 72px; }
    .cabeza { padding-top: 32px; }
    .filtros__botones { gap: 0 20px; }
    .buscador { width: 100%; }
    .destacados { gap: 64px; }
    .rejilla { grid-template-columns: 1fr; gap: 56px; }
    .otro { padding: 16px; }
  }
</style>
