---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import { fotos, altFotos } from '@/lib/fotos';
import Icono, { type NombreIcono } from '@/components/Icono.astro';
import { ruta, tx, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = (slug: string) => ruta(lang, `/proyectos/${slug}/`);
const alt = altFotos[lang];

const c = tx(lang, {
  es: {
    titulo: 'Sobre mí',
    descripcion: 'Estudiante de Ingeniería en Ciencias de la Computación en la UEES. Me gusta llevar las cosas hasta producción.',
    retrato: 'Tu retrato',
    disponible: 'Disponible para prácticas en 2027',
    intro: 'Soy Fabián Rodas, estudiante de Ingeniería en Ciencias de la Computación en la UEES. Me gusta llevar las cosas hasta producción: diseñar la interfaz, escribir el backend, configurar el servidor y seguir publicando versiones.',
    intro2: 'Así nació Lumen, un álbum familiar que hoy corre en mi propio servidor, y así estoy construyendo Cifra en Rust. En 2026 hice mi pasantía de desarrollo web en Futuresoft, con Flask, React y SQL Server.',
    datos: [
      { icono: 'map-pin', eti: 'Ubicación', valor: 'Guayaquil, Ecuador' },
      { icono: 'graduation-cap', eti: 'Universidad', valor: 'UEES, séptimo semestre' },
      { icono: 'calendar', eti: 'Graduación', valor: '2027' },
      { icono: 'languages', eti: 'Idiomas', valor: 'Español nativo, inglés B2' },
    ],
    hago: 'Qué hago',
    areas: [
      { icono: 'layout', titulo: 'Interfaces', texto: 'Pantallas claras y rápidas, que funcionan bien en el teléfono y se pueden usar con teclado.', chips: ['React', 'Angular', 'Astro', 'Figma'] },
      { icono: 'code', titulo: 'Servidores y APIs', texto: 'APIs REST con validación y manejo de errores, conectadas a bases de datos relacionales.', chips: ['Flask', 'Express', 'Laravel', 'Rust'] },
      { icono: 'database', titulo: 'Datos e infraestructura', texto: 'Modelado de datos, procesos ETL y despliegues en servidores Linux con Docker.', chips: ['PostgreSQL', 'Docker', 'Kafka', 'AWS'] },
    ],
    experiencia: 'Experiencia',
    experienciaTexto: 'Donde he trabajado con equipos y clientes reales.',
    exp1: { puesto: 'Pasante de desarrollo web', lugar: 'Futuresoft Business Service, Guayaquil', fecha: 'Feb–Abr 2026', puntos: ['Desarrollé funciones web con Flask, React y SQL Server para sistemas empresariales.', 'Conecté frontend y backend con APIs REST, Axios y React Query.', 'Mejoré la validación y el control de errores en módulos de registros.'] },
    exp2: { puesto: 'Desarrollo para clientes', lugar: 'Independiente, Guayaquil', fecha: '2025 a hoy', texto: 'Sitios y paneles para negocios locales: del diseño aprobado en un lienzo hasta el despliegue y el dominio.' },
    educacion: 'Educación',
    educacionTexto: 'Lo formal, con lo que más me sirvió de cada etapa.',
    edu1: { fecha: '2023 a 2027', titulo: 'Ingeniería en Ciencias de la Computación', lugar: 'Universidad de Especialidades Espíritu Santo', nota: 'Promedio de 91,81 sobre 100', chips: ['Sistemas Inteligentes', 'Ingeniería de Software', 'Bases de Datos', 'Análisis de Algoritmos', 'Datos masivos'] },
    edu2: { fecha: 'Hasta 2023', titulo: 'Bachillerato técnico en informática', lugar: 'Unidad Educativa Jefferson', nota: 'Mejor promedio de graduación y portaestandarte del plantel.' },
    cert: 'Certificaciones y cursos',
    ingles: 'Inglés B2, certificación Cambridge',
    certs: [
      { titulo: 'Cloud Foundations', texto: 'AWS Academy, 2025, 20 horas' },
      { titulo: 'Data Engineering', texto: 'AWS Academy, 2024, 40 horas' },
      { titulo: 'Programación en C', texto: 'Udemy, 2025, 25 horas' },
      { titulo: 'Python y Power BI', texto: 'DataCamp, 2023, 10 cursos' },
    ],
    fuera: 'Fuera del código',
    fueraTexto: 'Algunas fotos de lo que hago cuando no estoy programando.',
    foto: 'Foto personal',
    pies: ['Viajes con cámara (foto de ejemplo)', 'Caminatas por la montaña (foto de ejemplo)', 'Ideas en papel antes de programar (foto de ejemplo)'],
    cta: '¿Buscas a alguien para tu equipo?',
    ctaTexto: 'Estoy disponible para prácticas desde enero de 2027.',
  },
  en: {
    titulo: 'About me',
    descripcion: 'Computer Science Engineering student at UEES. I like taking things all the way to production.',
    retrato: 'Your portrait',
    disponible: 'Available for internships in 2027',
    intro: "I'm Fabián Rodas, a Computer Science Engineering student at UEES. I like taking things all the way to production: designing the interface, writing the backend, setting up the server and shipping new versions.",
    intro2: "That's how Lumen was born, a family album that now runs on my own server, and that's how I'm building Cifra in Rust. In 2026 I did my web development internship at Futuresoft, with Flask, React and SQL Server.",
    datos: [
      { icono: 'map-pin', eti: 'Location', valor: 'Guayaquil, Ecuador' },
      { icono: 'graduation-cap', eti: 'University', valor: 'UEES, seventh semester' },
      { icono: 'calendar', eti: 'Graduation', valor: '2027' },
      { icono: 'languages', eti: 'Languages', valor: 'Native Spanish, B2 English' },
    ],
    hago: 'What I do',
    areas: [
      { icono: 'layout', titulo: 'Interfaces', texto: 'Clear, fast screens that work well on phones and can be used with a keyboard.', chips: ['React', 'Angular', 'Astro', 'Figma'] },
      { icono: 'code', titulo: 'Servers and APIs', texto: 'REST APIs with validation and error handling, backed by relational databases.', chips: ['Flask', 'Express', 'Laravel', 'Rust'] },
      { icono: 'database', titulo: 'Data and infrastructure', texto: 'Data modeling, ETL processes and deployments on Linux servers with Docker.', chips: ['PostgreSQL', 'Docker', 'Kafka', 'AWS'] },
    ],
    experiencia: 'Experience',
    experienciaTexto: "Where I've worked with real teams and clients.",
    exp1: { puesto: 'Web development intern', lugar: 'Futuresoft Business Service, Guayaquil', fecha: 'Feb–Apr 2026', puntos: ['Built web features with Flask, React and SQL Server for business systems.', 'Connected frontend and backend through REST APIs, Axios and React Query.', 'Improved validation and error handling in record modules.'] },
    exp2: { puesto: 'Client development', lugar: 'Freelance, Guayaquil', fecha: '2025 to today', texto: 'Sites and dashboards for local businesses: from a design approved on a canvas to deployment and domain.' },
    educacion: 'Education',
    educacionTexto: 'The formal part, with what helped me most at each stage.',
    edu1: { fecha: '2023 to 2027', titulo: 'Computer Science Engineering', lugar: 'Universidad de Especialidades Espíritu Santo', nota: 'GPA of 91.81 out of 100', chips: ['Intelligent Systems', 'Software Engineering', 'Databases', 'Algorithm Analysis', 'Big Data'] },
    edu2: { fecha: 'Until 2023', titulo: 'Technical high school diploma in computing', lugar: 'Unidad Educativa Jefferson', nota: 'Top graduating GPA and school flag bearer.' },
    cert: 'Certifications and courses',
    ingles: 'B2 English, Cambridge certificate',
    certs: [
      { titulo: 'Cloud Foundations', texto: 'AWS Academy, 2025, 20 hours' },
      { titulo: 'Data Engineering', texto: 'AWS Academy, 2024, 40 hours' },
      { titulo: 'C Programming', texto: 'Udemy, 2025, 25 hours' },
      { titulo: 'Python and Power BI', texto: 'DataCamp, 2023, 10 courses' },
    ],
    fuera: 'Away from code',
    fueraTexto: "A few photos of what I do when I'm not programming.",
    foto: 'Personal photo',
    pies: ['Travelling with a camera (sample photo)', 'Mountain hikes (sample photo)', 'Ideas on paper before coding (sample photo)'],
    cta: 'Looking for someone for your team?',
    ctaTexto: "I'm available for internships starting January 2027.",
  },
});
---
<Base lang={lang} titulo={c.titulo} descripcion={c.descripcion} seccion="sobre">
  <main id="contenido" class="contenedor sobre">
    <section aria-labelledby="sobre-title" class="hero">
      <figure class="hero__foto">
        <span class="hero__panel" aria-hidden="true"></span>
        <Image src={fotos.retrato} alt={alt.retrato} widths={[420, 640, 800]} sizes="(max-width: 760px) 90vw, 38vw" format="webp" loading="eager" fetchpriority="high" class="hero__img" />
        <figcaption class="hero__disponible">{c.disponible}</figcaption>
      </figure>
      <div class="hero__texto entrada">
        <h1 id="sobre-title" class="h1-pagina">{c.titulo}</h1>
        <p class="hero__intro">{c.intro}</p>
        <p class="texto-sec">{c.intro2}</p>
        <div class="datos">
          {c.datos.map((x) => (
            <div class="dato">
              <Icono nombre={x.icono as NombreIcono} size={20} stroke="#c9ad95" />
              <span class="dato__texto"><span class="dato__eti">{x.eti}</span><span>{x.valor}</span></span>
            </div>
          ))}
        </div>
        <div class="botones">
          <a href={sitio.cv} class="btn btn--acento" download><Icono nombre="download" size={16} />{t('pie.cv')}</a>
          <a href={ruta(lang, '/contacto/')} class="btn">{t('escribeme')}</a>
        </div>
      </div>
    </section>

    <section aria-labelledby="hago-title" class="seccion banda banda--pad">
      <h2 id="hago-title" class="h2-grande">{c.hago}</h2>
      <div class="areas">
        {c.areas.map((a) => (
          <div class="area">
            <h3 class="area__titulo">{a.titulo}</h3>
            <p class="area__texto">{a.texto}</p>
            <div class="chips area__chips">{a.chips.map((x) => <span class="chip">{x}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="exp-title" class="dos">
      <div class="dos__cabeza">
        <h2 id="exp-title" class="h2-grande">{c.experiencia}</h2>
        <p class="texto-sec">{c.experienciaTexto}</p>
      </div>
      <ol class="exps">
        <li class="exp">
          <div class="exp__cuerpo">
            <div class="exp__fila">
              <span class="exp__titulos"><span class="exp__puesto">{c.exp1.puesto}</span><span class="texto-sec">{c.exp1.lugar}</span></span>
              <span class="chip chip--m">{c.exp1.fecha}</span>
            </div>
            <ul class="exp__puntos">{c.exp1.puntos.map((x) => <li>{x}</li>)}</ul>
            <div class="chips">{['Flask', 'React', 'SQL Server', 'Material UI'].map((x) => <span class="chip">{x}</span>)}</div>
          </div>
        </li>
        <li class="exp">
          <div class="exp__cuerpo">
            <div class="exp__fila">
              <span class="exp__titulos"><span class="exp__puesto">{c.exp2.puesto}</span><span class="texto-sec">{c.exp2.lugar}</span></span>
              <span class="chip chip--m">{c.exp2.fecha}</span>
            </div>
            <p class="exp__texto">{c.exp2.texto}</p>
            <div class="chips">
              <a href={p('taller')} class="chip chip--acento">Taller</a>
              <a href={p('nodo')} class="chip chip--acento">Nodo</a>
            </div>
          </div>
        </li>
      </ol>
    </section>

    <section aria-labelledby="edu-title" class="dos">
      <div class="dos__cabeza">
        <h2 id="edu-title" class="h2-grande">{c.educacion}</h2>
        <p class="texto-sec">{c.educacionTexto}</p>
      </div>
      <div class="edus">
        <div class="edu">
          <span class="chip chip--m edu__fecha">{c.edu1.fecha}</span>
          <span class="edu__titulos"><span class="edu__titulo">{c.edu1.titulo}</span><span class="texto-sec">{c.edu1.lugar}</span></span>
          <span class="edu__nota">{c.edu1.nota}</span>
          <div class="chips">{c.edu1.chips.map((x) => <span class="chip">{x}</span>)}</div>
        </div>
        <div class="edu">
          <span class="chip chip--m edu__fecha">{c.edu2.fecha}</span>
          <span class="edu__titulos"><span class="edu__titulo">{c.edu2.titulo}</span><span class="texto-sec">{c.edu2.lugar}</span></span>
          <span class="edu__nota edu__nota--suave">{c.edu2.nota}</span>
        </div>
      </div>
    </section>

    <section aria-labelledby="cert-title" class="seccion banda banda--pad">
      <div class="seccion-cabecera">
        <h2 id="cert-title" class="h2-grande">{c.cert}</h2>
        <span class="texto-sec">{c.ingles}</span>
      </div>
      <div class="certs">
        {c.certs.map((x) => (
          <div class="cert">
            <span class="cert__titulo">{x.titulo}</span>
            <span class="cert__texto">{x.texto}</span>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="fuera-title" class="seccion">
      <div class="seccion-cabecera__texto">
        <h2 id="fuera-title" class="h2-grande">{c.fuera}</h2>
        <p class="texto-sec">{c.fueraTexto}</p>
      </div>
      <div class="fotos" data-entra>
        {[
          { src: fotos.camara, alt: alt.camara, pie: c.pies[0] },
          { src: fotos.niebla, alt: alt.niebla, pie: c.pies[1] },
          { src: fotos.libreta, alt: alt.libreta, pie: c.pies[2] },
        ].map((f) => (
          <figure class="foto">
            <Image src={f.src} alt={f.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" class="foto-hd" />
            <figcaption>{f.pie}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section aria-labelledby="cta-title" class="cta" data-entra>
      <div class="cta__texto">
        <h2 id="cta-title" class="cta__titulo">{c.cta}</h2>
        <p class="cta__sub">{c.ctaTexto}</p>
      </div>
      <div class="cta__botones">
        <a href={ruta(lang, '/contacto/')} class="btn btn--acento">{t('escribeme')}</a>
        <a href={sitio.cv} class="btn btn--oscuro" download>{t('pie.cv')}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .sobre :global(.h2-grande) { line-height: 1.55; }
  .sobre { padding-bottom: 112px; display: flex; flex-direction: column; gap: 104px; }
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; padding-top: 56px; }
  .hero__foto { position: relative; display: flex; flex-direction: column; align-items: center; }
  .hero__panel { position: absolute; left: 0; right: 0; top: 18%; bottom: 44px; background: var(--c-superficie); }
  .hero__foto :global(.hero__img) { position: relative; width: min(100%, 460px); height: auto; }
  .hero__disponible { position: relative; align-self: stretch; padding: 12px 0 0; color: var(--c-acento-claro); font-size: var(--t-pequeno); }
  .hero__texto { display: flex; flex-direction: column; gap: 20px; }
  .hero__intro { font-size: var(--t-entrada); line-height: 1.45; }
  .datos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding-top: 4px; }
  .dato { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: 0; background: var(--c-superficie); }
  .dato__texto { display: flex; flex-direction: column; }
  .dato__eti { font-size: 13px; color: var(--c-secundario); }
  .botones { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 4px; }

  .seccion { display: flex; flex-direction: column; gap: 24px; }
  .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .area { display: flex; flex-direction: column; gap: 12px; padding: 26px; border-radius: var(--r-l); background: var(--c-superficie); }
  .area__titulo { font-size: 1.5rem; letter-spacing: -0.015em; }
  .area__texto { font-size: 15px; color: var(--c-secundario); }
  .area__chips { padding-top: 4px; }

  .dos { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
  .dos__cabeza { display: flex; flex-direction: column; gap: 10px; }
  .exps { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .exp { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 26px; border-radius: var(--r-l); background: var(--c-superficie); }
  .exp__logo {
    display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: var(--r-img);
    background: var(--c-superficie-2); color: var(--c-acento); font-family: var(--f-titulo); font-weight: 500;
  }
  .exp__logo--claro { background: var(--c-texto); color: var(--c-fondo); }
  .exp__cuerpo { display: flex; flex-direction: column; gap: 10px; }
  .exp__fila { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .exp__titulos { display: flex; flex-direction: column; }
  .exp__puesto { font-size: 19px; font-weight: 400; }
  .exp__puntos { padding: 0 0 0 1.1em; display: flex; flex-direction: column; gap: 6px; color: var(--c-suave); font-size: 15px; }
  .exp__texto { color: var(--c-suave); font-size: 15px; }

  .edus { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 16px; }
  .edu { display: flex; flex-direction: column; gap: 12px; padding: 26px; border-radius: var(--r-l); background: var(--c-superficie); }
  .edu__fecha { align-self: flex-start; }
  .edu__titulos { display: flex; flex-direction: column; }
  .edu__titulo { font-size: 19px; font-weight: 400; }
  .edu__nota { font-size: 15px; }
  .edu__nota--suave { color: var(--c-suave); }

  .certs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .cert { display: flex; flex-direction: column; gap: 10px; padding: 22px; border-radius: var(--r-m); background: var(--c-superficie); }
  .cert__titulo { font-weight: 400; }
  .cert__texto { font-size: 14px; color: var(--c-secundario); }

  .fotos { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: end; }
  .foto { display: flex; flex-direction: column; gap: 10px; }
  .foto figcaption { font-size: 14px; color: var(--c-secundario); }

  .cta {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; align-items: center; padding: 36px 40px;
    border-radius: var(--r-xl); background: var(--c-fondo-acento);
  }
  .cta__texto { display: flex; flex-direction: column; gap: 6px; }
  .cta__titulo { font-family: var(--f-titulo); font-size: 26px; font-weight: 400; letter-spacing: -0.02em; }
  .cta__sub { color: var(--c-suave-acento); }
  .cta__botones { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 1040px) {
    .sobre { gap: 80px; }
    .hero { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 32px; }
    .dos { grid-template-columns: 1fr; gap: 24px; }
    .areas { grid-template-columns: 1fr; }
    .certs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .sobre { gap: 64px; padding-bottom: 64px; }
    .hero { display: flex; flex-direction: column-reverse; align-items: stretch; gap: 28px; padding-top: 28px; }
    .hero__intro { font-size: 17px; }
    .dato { padding: 14px; gap: 10px; }
    .exp { grid-template-columns: 1fr; padding: 20px; gap: 14px; }
    .edus { grid-template-columns: 1fr; }
    .edu { padding: 20px; }
    .certs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .cert { padding: 18px; }
    .fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .foto:first-child { grid-column: 1 / -1; }
    .cta { padding: 24px; border-radius: var(--r-l); }
    .cta__titulo { font-size: 22px; }
  }
</style>
