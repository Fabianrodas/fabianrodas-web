---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import Icono from '@/components/Icono.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, type Lang } from '@/i18n/ui';
import { obtenerProyectos, type Proyecto } from '@/lib/contenido';

interface Props {
  lang: Lang;
  proyecto: Proyecto;
}
const { lang, proyecto } = Astro.props;
const d = proyecto.data;
const caso = d.case;

const todos = await obtenerProyectos(lang);
const otros = todos.filter((p) => p.data.featured && p.data.slug !== d.slug).slice(0, 3);

const c = tx(lang, {
  es: {
    ruta: 'Ruta',
    proyectos: 'Proyectos',
    verSitio: 'Ver el sitio',
    verCodigo: 'Ver el código',
    privado: 'Código privado',
    rol: 'Rol',
    periodo: 'Periodo',
    tipo: 'Tipo',
    plataforma: 'Plataforma',
    stack: 'Stack',
    indice: 'En este caso',
    problema: 'El problema',
    solucion: 'La solución',
    decisiones: 'Decisiones técnicas',
    arquitectura: 'Arquitectura',
    aprendi: 'Lo que aprendí',
    otros: 'Otros proyectos',
    verTodos: 'Ver todos',
  },
  en: {
    ruta: 'Breadcrumb',
    proyectos: 'Projects',
    verSitio: 'Visit the site',
    verCodigo: 'See the code',
    privado: 'Private code',
    rol: 'Role',
    periodo: 'Period',
    tipo: 'Type',
    plataforma: 'Platform',
    stack: 'Stack',
    indice: 'In this case study',
    problema: 'The problem',
    solucion: 'The solution',
    decisiones: 'Technical decisions',
    arquitectura: 'Architecture',
    aprendi: 'What I learned',
    otros: 'Other projects',
    verTodos: 'See all',
  },
});

const secciones = [
  { id: 'problema', label: c.problema, hay: (caso?.problem.length ?? 0) > 0 },
  { id: 'solucion', label: c.solucion, hay: (caso?.solution.length ?? 0) > 0 || (caso?.features.length ?? 0) > 0 },
  { id: 'decisiones', label: c.decisiones, hay: (caso?.decisions.length ?? 0) > 0 },
  { id: 'arquitectura', label: c.arquitectura, hay: !!caso?.architecture },
  { id: 'aprendi', label: c.aprendi, hay: (caso?.learned.length ?? 0) > 0 },
].filter((s) => s.hay);

const galeria = caso?.gallery ?? { main: { cover: d.cover, caption: d.summary } };
---
<Base lang={lang} titulo={d.title} descripcion={d.summary} seccion="proyectos" tipo="article">
  <main id="contenido" class="contenedor caso">
    <nav aria-label={c.ruta} class="migas">
      <a href={ruta(lang, '/proyectos/')}>{c.proyectos}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{d.title}</span>
    </nav>

    <section aria-labelledby="caso-title" class="cabeza">
      <div class="cabeza__texto entrada">
        <div class="chips">
          <ChipEstado estado={d.status} lang={lang} grande />
          {d.version && <span class="chip chip--m">v{d.version}</span>}
        </div>
        <h1 id="caso-title" class="cabeza__titulo">{d.title}</h1>
        <p class="cabeza__intro">{d.summary}</p>
        <div class="cabeza__botones">
          {d.links.live && (
            <a href={d.links.live} class="btn btn--acento cabeza__btn" target="_blank" rel="noopener">{c.verSitio}<Icono nombre="arrow-up-right" size={16} /></a>
          )}
          {d.links.repo && !d.links.privateRepo && (
            <a href={d.links.repo} class="btn cabeza__btn cabeza__btn--sec" target="_blank" rel="noopener"><Icono nombre="github" size={16} />{c.verCodigo}</a>
          )}
          {d.links.privateRepo && (
            <span class="privado"><Icono nombre="lock" size={16} />{c.privado}</span>
          )}
        </div>
      </div>
      <dl class="ficha">
        <dt>{c.rol}</dt><dd>{d.role}</dd>
        {d.period && (<><dt>{c.periodo}</dt><dd>{d.period}</dd></>)}
        {d.kind && (<><dt>{c.tipo}</dt><dd>{d.kind}</dd></>)}
        {d.platform && (<><dt>{c.plataforma}</dt><dd>{d.platform}</dd></>)}
        <dt>{c.stack}</dt>
        <dd class="chips">{d.stack.map((s) => <span class="chip">{s}</span>)}</dd>
      </dl>
    </section>

    <figure class="galeria-principal">
      <Shot portada={galeria.main.cover} ratio="16 / 9" radius="14px" lang={lang} prioridad />
      <figcaption>{galeria.main.caption}</figcaption>
    </figure>

    {(galeria.mobile || galeria.secondary) && (
      <div class="galeria">
        {galeria.mobile && (
          <figure class="galeria__movil revelar">
            <div class="galeria__telefono"><Shot portada={galeria.mobile.cover} ratio="9 / 19" radius="22px" lang={lang} /></div>
            <figcaption>{galeria.mobile.caption}</figcaption>
          </figure>
        )}
        {galeria.secondary && (
          <figure class="galeria__sec revelar">
            <Shot portada={galeria.secondary.cover} radius="14px" lang={lang} />
            <figcaption>{galeria.secondary.caption}</figcaption>
          </figure>
        )}
      </div>
    )}

    <div class="cuerpo">
      <aside class="indice">
        <nav aria-label={c.indice} class="indice__nav" data-indice>
          {secciones.map((s, i) => (
            <a href={`#${s.id}`} class:list={{ activo: i === 0 }} aria-current={i === 0 ? 'true' : undefined}>{s.label}</a>
          ))}
        </nav>
      </aside>

      <article class="articulo">
        {caso && caso.problem.length > 0 && (
          <section id="problema" aria-labelledby="h-problema" class="sec">
            <h2 id="h-problema" class="h2-medio">{c.problema}</h2>
            {caso.problem.map((p) => <p class="parrafo">{p}</p>)}
          </section>
        )}
        {caso && (caso.solution.length > 0 || caso.features.length > 0) && (
          <section id="solucion" aria-labelledby="h-solucion" class="sec">
            <h2 id="h-solucion" class="h2-medio">{c.solucion}</h2>
            {caso.solution.map((p) => <p class="parrafo">{p}</p>)}
            {caso.features.length > 0 && (
              <ul class="funciones">
                {caso.features.map((f) => <li><Icono nombre="check" stroke="#9fc7b8" grosor={2} class="funciones__check" />{f}</li>)}
              </ul>
            )}
          </section>
        )}
        {caso && caso.decisions.length > 0 && (
          <section id="decisiones" aria-labelledby="h-decisiones" class="sec sec--16">
            <h2 id="h-decisiones" class="h2-medio">{c.decisiones}</h2>
            <div class="decisiones">
              {caso.decisions.map((x) => (
                <div class="decision">
                  <Icono nombre={x.icon} size={22} stroke="#9fc7b8" />
                  <h3>{x.title}</h3>
                  <p>{x.text}</p>
                </div>
              ))}
            </div>
          </section>
        )}
        {caso?.architecture && (
          <section id="arquitectura" aria-labelledby="h-arquitectura" class="sec sec--16">
            <h2 id="h-arquitectura" class="h2-medio">{c.arquitectura}</h2>
            {caso.architecture.intro && <p class="parrafo">{caso.architecture.intro}</p>}
            <figure class="arq">
              <div class="arq__fila" style={`--n: ${caso.architecture.nodes.length}`}>
                {caso.architecture.nodes.map((n, i) => (
                  <>
                    {i > 0 && <Icono nombre="arrow-right" stroke="#9aa099" grosor={1.6} class="arq__flecha" />}
                    <div class:list={['arq__nodo', { 'arq__nodo--destacado': n.highlight }]}>
                      <span class="arq__titulo">{n.title}</span>
                      <span class="arq__texto">{n.text}</span>
                    </div>
                  </>
                ))}
              </div>
              {caso.architecture.caption && <figcaption>{caso.architecture.caption}</figcaption>}
            </figure>
          </section>
        )}
        {caso && caso.learned.length > 0 && (
          <section id="aprendi" aria-labelledby="h-aprendi" class="sec">
            <h2 id="h-aprendi" class="h2-medio">{c.aprendi}</h2>
            {caso.learned.map((p) => <p class="parrafo">{p}</p>)}
          </section>
        )}
      </article>
    </div>

    {otros.length > 0 && (
      <section aria-labelledby="mas-title" class="mas">
        <div class="sec__cabecera">
          <h2 id="mas-title" class="h2-medio">{c.otros}</h2>
          <a href={ruta(lang, '/proyectos/')} class="mas__todos">{c.verTodos}</a>
        </div>
        <div class="mas__rejilla">
          {otros.map((p) => (
            <a href={ruta(lang, `/proyectos/${p.data.slug}/`)} class="tarjeta mas__tarjeta revelar">
              <Shot portada={p.data.cover} radius="12px" lang={lang} />
              <span class="mas__pie">
                <span class="mas__nombre">{p.data.title}</span>
                <span class="mas__dato">{p.data.stack[0]}, {p.data.year}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>

<script>
  import { iniciarIndice } from '@/scripts/indice';
  iniciarIndice();
</script>

<style>
  .caso { padding-bottom: 112px; }
  .migas { display: flex; gap: 8px; align-items: center; padding-top: 40px; font-size: 14px; color: var(--c-secundario); }
  .migas a { color: var(--c-secundario); text-underline-offset: 4px; }
  .migas [aria-current] { color: var(--c-texto); }

  .cabeza { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: start; padding: 28px 0 40px; }
  .cabeza__texto { display: flex; flex-direction: column; gap: 18px; }
  .cabeza__titulo { font-family: var(--f-titulo); font-size: 48px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .cabeza__intro { max-width: 54ch; font-size: 19px; line-height: 1.5; color: var(--c-suave); }
  .cabeza__botones { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 4px; }
  .cabeza__btn { height: 44px; padding: 0 20px; }
  .cabeza__btn--sec { background: var(--c-superficie); font-weight: 400; }
  .privado {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: var(--r-pildora);
    background: var(--c-superficie); color: var(--c-secundario); font-size: 15px;
  }
  .ficha {
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 24px; row-gap: 14px; padding: 24px;
    border-radius: var(--r-m); background: var(--c-superficie); font-size: 15px;
  }
  .ficha dt { color: var(--c-secundario); }

  .galeria-principal { padding: 12px; border-radius: var(--r-xl); background: var(--c-superficie); }
  figcaption { font-size: 14px; color: var(--c-secundario); }
  .galeria-principal figcaption { padding: 14px 6px 2px; }
  .galeria { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px; padding-top: 20px; }
  .galeria__movil {
    display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36px 24px 20px;
    border-radius: var(--r-xl); background: var(--c-fondo-acento);
  }
  .galeria__telefono { width: 46%; }
  .galeria__movil figcaption { padding-top: 16px; color: var(--c-suave-acento); }
  .galeria__sec { display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 24px; border-radius: var(--r-xl); background: var(--c-superficie); }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 48px; padding-top: 88px; }
  .indice { align-self: start; position: sticky; top: 24px; display: flex; flex-direction: column; gap: 20px; }
  .indice__nav { display: flex; flex-direction: column; gap: 2px; padding: 8px; border-radius: var(--r-card); background: var(--c-superficie); font-size: 14px; }
  .indice__nav a { padding: 9px 12px; border-radius: var(--r-s); color: var(--c-secundario); text-decoration: none; }
  .indice__nav a:hover { color: var(--c-texto); }
  .indice__nav a.activo { background: var(--c-superficie-2); color: var(--c-texto); }

  .articulo { display: flex; flex-direction: column; gap: 56px; max-width: 760px; }
  .sec { display: flex; flex-direction: column; gap: 14px; }
  .sec--16 { gap: 16px; }
  .parrafo { font-size: 17px; line-height: 1.7; color: var(--c-suave); }
  .funciones { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; font-size: 15px; }
  .funciones li { display: flex; gap: 10px; align-items: flex-start; padding: 14px 16px; border-radius: var(--r-img); background: var(--c-superficie); }
  .funciones :global(.funciones__check) { margin-top: 2px; }
  .decisiones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .decision { display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: var(--r-card); background: var(--c-superficie); }
  .decision h3 { font-size: 17px; font-weight: 600; }
  .decision p { font-size: 14px; color: var(--c-secundario); }

  .arq { padding: 28px; border-radius: var(--r-m); background: var(--c-superficie); }
  .arq__fila { display: flex; align-items: center; gap: 6px; }
  .arq__nodo { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding: 14px; border-radius: var(--r-img); background: var(--c-superficie-2); }
  .arq__nodo--destacado { background: var(--c-fondo-acento); }
  .arq__titulo { font-size: 15px; font-weight: 600; }
  .arq__nodo--destacado .arq__titulo { color: var(--c-acento); }
  .arq__texto { font-size: 13px; color: var(--c-secundario); }
  .arq__nodo--destacado .arq__texto { color: var(--c-suave-acento); }
  .arq figcaption { padding-top: 14px; }

  .sec__cabecera { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }

  .mas { display: flex; flex-direction: column; gap: 20px; padding-top: 96px; }
  .mas__todos { font-size: 15px; color: var(--c-texto); text-underline-offset: 4px; }
  .mas__rejilla { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .mas__tarjeta { gap: 14px; padding: 8px 8px 18px; border-radius: var(--r-card); }
  .mas__pie { display: flex; justify-content: space-between; align-items: center; padding: 0 8px; }
  .mas__nombre { font-family: var(--f-titulo); font-size: 20px; font-weight: 600; }
  .mas__dato { font-size: 14px; color: var(--c-secundario); }

  @media (max-width: 1040px) {
    .cabeza { grid-template-columns: 1fr; gap: 28px; }
    .cuerpo { grid-template-columns: 1fr; gap: 32px; padding-top: 56px; }
    .indice { position: static; }
    .indice__nav { flex-direction: row; flex-wrap: wrap; }
    .arq__fila { flex-direction: column; align-items: stretch; }
    .arq :global(.arq__flecha) { transform: rotate(90deg); align-self: center; }
    .mas__rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .caso { padding-bottom: 64px; }
    .migas { padding-top: 24px; }
    .cabeza { padding: 20px 0 28px; }
    .cabeza__titulo { font-size: 36px; }
    .cabeza__intro { font-size: 17px; }
    .ficha { padding: 20px; column-gap: 16px; }
    .galeria-principal { padding: 6px; border-radius: var(--r-m); }
    .galeria { grid-template-columns: 1fr; gap: 16px; padding-top: 16px; }
    .galeria__movil, .galeria__sec { border-radius: var(--r-m); padding: 24px 16px 16px; }
    .galeria__telefono { width: 56%; }
    .indice { display: none; }
    .articulo { gap: 44px; }
    .parrafo { font-size: 16px; }
    .funciones, .decisiones, .mas__rejilla { grid-template-columns: 1fr; }
    .arq { padding: 16px; }
    .sec__cabecera { flex-wrap: wrap; }
    .mas { padding-top: 64px; }
  }
</style>
