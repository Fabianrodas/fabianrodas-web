---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, type Lang } from '@/i18n/ui';
import { obtenerProyectos, type Proyecto } from '@/lib/contenido';

interface Props {
  lang: Lang;
  proyecto: Proyecto;
}
const { lang, proyecto } = Astro.props;
const d = proyecto.data;
const caso = d.case;

const todos = await obtenerProyectos(lang);
const otros = todos.filter((p) => p.data.featured && p.data.slug !== d.slug).slice(0, 3);

const c = tx(lang, {
  es: {
    ruta: 'Ruta',
    proyectos: 'Proyectos',
    verSitio: 'Ver el sitio',
    verCodigo: 'Ver el código',
    privado: 'Código privado',
    rol: 'Rol',
    periodo: 'Periodo',
    tipo: 'Tipo',
    plataforma: 'Plataforma',
    stack: 'Stack',
    indice: 'En este caso',
    problema: 'El problema',
    solucion: 'La solución',
    decisiones: 'Decisiones técnicas',
    arquitectura: 'Arquitectura',
    aprendi: 'Lo que aprendí',
    otros: 'Otros proyectos',
    verTodos: 'Ver todos',
  },
  en: {
    ruta: 'Breadcrumb',
    proyectos: 'Projects',
    verSitio: 'Visit the site',
    verCodigo: 'See the code',
    privado: 'Private code',
    rol: 'Role',
    periodo: 'Period',
    tipo: 'Type',
    plataforma: 'Platform',
    stack: 'Stack',
    indice: 'In this case study',
    problema: 'The problem',
    solucion: 'The solution',
    decisiones: 'Technical decisions',
    arquitectura: 'Architecture',
    aprendi: 'What I learned',
    otros: 'Other projects',
    verTodos: 'See all',
  },
});

const secciones = [
  { id: 'problema', label: c.problema, hay: (caso?.problem.length ?? 0) > 0 },
  { id: 'solucion', label: c.solucion, hay: (caso?.solution.length ?? 0) > 0 || (caso?.features.length ?? 0) > 0 },
  { id: 'decisiones', label: c.decisiones, hay: (caso?.decisions.length ?? 0) > 0 },
  { id: 'arquitectura', label: c.arquitectura, hay: !!caso?.architecture },
  { id: 'aprendi', label: c.aprendi, hay: (caso?.learned.length ?? 0) > 0 },
].filter((s) => s.hay);

const galeria = caso?.gallery ?? { main: { cover: d.cover, caption: d.summary } };
---
<Base lang={lang} titulo={d.title} descripcion={d.summary} seccion="proyectos" tipo="article">
  <main id="contenido" class="contenedor caso">
    <nav aria-label={c.ruta} class="migas">
      <a href={ruta(lang, '/proyectos/')}>{c.proyectos}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{d.title}</span>
    </nav>

    <section aria-labelledby="caso-title" class="cabeza">
      <div class="cabeza__texto entrada">
        <h1 id="caso-title" class="cabeza__titulo">{d.title}</h1>
        <p class="cabeza__intro">{d.summary}</p>
        <p class="linea"><ChipEstado estado={d.status} lang={lang} version={d.version} />{d.period && ` · ${d.period}`}</p>
        <div class="cabeza__botones">
          {d.links.live && (
            <a href={d.links.live} class="btn btn--acento cabeza__btn" target="_blank" rel="noopener">{c.verSitio}</a>
          )}
          {d.links.repo && !d.links.privateRepo && (
            <a href={d.links.repo} class="enlace" target="_blank" rel="noopener">{c.verCodigo}</a>
          )}
          {d.links.privateRepo && (
            <span class="privado">{c.privado}</span>
          )}
        </div>
      </div>
      <dl class="ficha">
        <dt>{c.rol}</dt><dd>{d.role}</dd>
        {d.period && (<><dt>{c.periodo}</dt><dd>{d.period}</dd></>)}
        {d.kind && (<><dt>{c.tipo}</dt><dd>{d.kind}</dd></>)}
        {d.platform && (<><dt>{c.plataforma}</dt><dd>{d.platform}</dd></>)}
        <dt>{c.stack}</dt>
        <dd>{d.stack.join(', ')}</dd>
      </dl>
    </section>

    <figure class="galeria-principal" data-ui>
      <Shot portada={galeria.main.cover} ratio="16 / 9" radius="0" lang={lang} prioridad />
      <figcaption>{galeria.main.caption}</figcaption>
    </figure>

    {(galeria.mobile || galeria.secondary) && (
      <div class="galeria" data-entra>
        {galeria.mobile && (
          <figure class="galeria__movil" data-ui>
            <div class="galeria__telefono"><Shot portada={galeria.mobile.cover} ratio="9 / 19" radius="22px" lang={lang} /></div>
            <figcaption>{galeria.mobile.caption}</figcaption>
          </figure>
        )}
        {galeria.secondary && (
          <figure class="galeria__sec" data-ui>
            <Shot portada={galeria.secondary.cover} radius="0" lang={lang} />
            <figcaption>{galeria.secondary.caption}</figcaption>
          </figure>
        )}
      </div>
    )}

    <div class="cuerpo">
      <aside class="indice">
        <nav aria-label={c.indice} class="indice__nav" data-indice>
          {secciones.map((s, i) => (
            <a href={`#${s.id}`} class:list={{ activo: i === 0 }} aria-current={i === 0 ? 'true' : undefined}>{s.label}</a>
          ))}
        </nav>
      </aside>

      <article class="articulo">
        {caso && caso.problem.length > 0 && (
          <section id="problema" aria-labelledby="h-problema" class="sec">
            <h2 id="h-problema" class="h2-medio">{c.problema}</h2>
            {caso.problem.map((p) => <p class="parrafo">{p}</p>)}
          </section>
        )}
        {caso && (caso.solution.length > 0 || caso.features.length > 0) && (
          <section id="solucion" aria-labelledby="h-solucion" class="sec">
            <h2 id="h-solucion" class="h2-medio">{c.solucion}</h2>
            {caso.solution.map((p) => <p class="parrafo">{p}</p>)}
            {caso.features.length > 0 && (
              <ul class="funciones">
                {caso.features.map((f) => <li>{f}</li>)}
              </ul>
            )}
          </section>
        )}
        {caso && caso.decisions.length > 0 && (
          <section id="decisiones" aria-labelledby="h-decisiones" class="sec sec--16">
            <h2 id="h-decisiones" class="h2-medio">{c.decisiones}</h2>
            <div class="decisiones">
              {caso.decisions.map((x) => (
                <div class="decision">
                  <h3>{x.title}</h3>
                  <p>{x.text}</p>
                </div>
              ))}
            </div>
          </section>
        )}
        {caso?.architecture && (
          <section id="arquitectura" aria-labelledby="h-arquitectura" class="sec sec--16">
            <h2 id="h-arquitectura" class="h2-medio">{c.arquitectura}</h2>
            {caso.architecture.intro && <p class="parrafo">{caso.architecture.intro}</p>}
            <figure class="arq">
              <div class="arq__fila" style={`--n: ${caso.architecture.nodes.length}`}>
                {caso.architecture.nodes.map((n, i) => (
                  <>
                    {i > 0 && <span class="arq__flecha" aria-hidden="true">→</span>}
                    <div class:list={['arq__nodo', { 'arq__nodo--destacado': n.highlight }]}>
                      <span class="arq__titulo">{n.title}</span>
                      <span class="arq__texto">{n.text}</span>
                    </div>
                  </>
                ))}
              </div>
              {caso.architecture.caption && <figcaption>{caso.architecture.caption}</figcaption>}
            </figure>
          </section>
        )}
        {caso && caso.learned.length > 0 && (
          <section id="aprendi" aria-labelledby="h-aprendi" class="sec">
            <h2 id="h-aprendi" class="h2-medio">{c.aprendi}</h2>
            {caso.learned.map((p) => <p class="parrafo">{p}</p>)}
          </section>
        )}
      </article>
    </div>

    {otros.length > 0 && (
      <section aria-labelledby="mas-title" class="mas">
        <div class="sec__cabecera">
          <h2 id="mas-title" class="h2-medio">{c.otros}</h2>
          <a href={ruta(lang, '/proyectos/')} class="enlace mas__todos">{c.verTodos}</a>
        </div>
        <div class="mas__rejilla" data-entra>
          {otros.map((p) => (
            <a href={ruta(lang, `/proyectos/${p.data.slug}/`)} class="mas__tarjeta">
              <span class="mas__imagen" data-ui><Shot portada={p.data.cover} radius="0" lang={lang} /></span>
              <span class="mas__pie">
                <span class="mas__nombre">{p.data.title}</span>
                <span class="mas__dato">{p.data.stack[0]}, {p.data.year}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>

<script>
  import { iniciarIndice } from '@/scripts/indice';
  iniciarIndice();
</script>

<style>
  .caso { padding-bottom: 48px; }
  .migas { display: flex; gap: 8px; align-items: center; padding-top: 40px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .migas a { color: var(--c-secundario); text-underline-offset: 4px; }
  .migas a:hover { color: var(--c-texto); }
  .migas [aria-current] { color: var(--c-texto); }

  .cabeza { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 72px; align-items: end; padding: 40px 0 56px; }
  .cabeza__texto { display: flex; flex-direction: column; gap: 20px; }
  .cabeza__titulo { font-size: var(--t-nombre); letter-spacing: -0.04em; line-height: 0.9; }
  .cabeza__intro { max-width: 40ch; font-size: var(--t-entrada); line-height: 1.35; }
  .linea { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .cabeza__botones { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; padding-top: 8px; }
  .privado { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .ficha { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 24px; row-gap: 14px; font-size: var(--t-pequeno); }
  .ficha dt { color: var(--c-secundario); }

  .galeria-principal { overflow: hidden; background: var(--c-superficie); }
  figcaption { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .galeria-principal figcaption { padding: 16px 20px; }
  .galeria { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px; padding-top: 20px; }
  .galeria__movil {
    display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 24px 20px;
    background: var(--c-superficie);
  }
  .galeria__telefono { width: 46%; }
  .galeria__movil figcaption { padding-top: 16px; }
  .galeria__sec { display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 24px; background: var(--c-superficie); }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 48px; padding-top: 120px; }
  .indice { align-self: start; position: sticky; top: 104px; }
  .indice__nav { display: flex; flex-direction: column; font-size: var(--t-pequeno); }
  .indice__nav a {
    display: flex; align-items: center; min-height: 40px; color: var(--c-secundario); text-decoration: underline;
    text-underline-offset: 6px; text-decoration-color: transparent;
  }
  .indice__nav a:hover { color: var(--c-texto); }
  .indice__nav a.activo { color: var(--c-texto); text-decoration-color: var(--c-acento); }

  .articulo { display: flex; flex-direction: column; gap: 80px; max-width: 760px; }
  .sec { display: flex; flex-direction: column; gap: 20px; }
  .sec--16 { gap: 24px; }
  .parrafo { line-height: 1.65; color: var(--c-suave); }
  .funciones { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; }
  .funciones li { padding: 18px 20px; background: var(--c-superficie); }
  .decisiones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .decision { display: flex; flex-direction: column; gap: 10px; }
  .decision h3 { font-size: var(--t-entrada); line-height: 1.2; }
  .decision p { font-size: var(--t-pequeno); color: var(--c-suave); }

  .arq { padding: 32px; background: var(--c-superficie); }
  .arq__fila { display: flex; align-items: center; gap: 12px; }
  .arq__nodo { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding: 16px; background: var(--c-superficie-2); }
  .arq__nodo--destacado { background: var(--c-acento); color: var(--c-acento-tinta); }
  .arq__titulo { font-size: var(--t-cuerpo); }
  .arq__texto { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .arq__nodo--destacado .arq__texto { color: var(--c-acento-tinta); }
  .arq__flecha { color: var(--c-secundario); }
  .arq figcaption { padding-top: 16px; }

  .sec__cabecera { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }

  .mas { display: flex; flex-direction: column; gap: 32px; padding-top: 144px; }
  .mas__todos { font-size: var(--t-pequeno); }
  .mas__rejilla { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .mas__tarjeta { display: flex; flex-direction: column; gap: 16px; color: var(--c-texto); text-decoration: none; }
  .mas__imagen { display: block; overflow: hidden; background: var(--c-superficie); }
  .mas__pie { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .mas__nombre { font-size: var(--t-entrada); }
  .mas__tarjeta:hover .mas__nombre { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--c-acento); }
  .mas__dato { font-size: var(--t-pequeno); color: var(--c-secundario); }
  @media (prefers-reduced-motion: no-preference) {
    .mas__imagen :global(.shot__lienzo) { transition: transform 700ms var(--ease-salida); }
    .mas__tarjeta:hover :global(.shot__lienzo) { transform: scale(1.03); }
  }

  @media (max-width: 1040px) {
    .cabeza { grid-template-columns: 1fr; gap: 32px; }
    .cuerpo { grid-template-columns: 1fr; gap: 32px; padding-top: 72px; }
    .indice { position: static; }
    .indice__nav { flex-direction: row; flex-wrap: wrap; column-gap: 24px; }
    .arq__fila { flex-direction: column; align-items: stretch; }
    .arq__flecha { transform: rotate(90deg); align-self: center; }
    .mas__rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .caso { padding-bottom: 72px; }
    .migas { padding-top: 24px; }
    .cabeza { padding: 24px 0 32px; }
    .cabeza__titulo { font-size: clamp(3rem, 14vw, 4.5rem); }
    .galeria { grid-template-columns: 1fr; gap: 12px; padding-top: 12px; }
    .galeria__movil, .galeria__sec { padding: 24px 16px 16px; }
    .galeria__telefono { width: 56%; }
    .indice { display: none; }
    .articulo { gap: 56px; }
    .funciones, .decisiones, .mas__rejilla { grid-template-columns: 1fr; }
    .arq { padding: 16px; }
    .sec__cabecera { flex-wrap: wrap; }
    .mas { padding-top: 96px; }
  }
</style>
