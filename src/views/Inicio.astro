---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import Icono from '@/components/Icono.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, useT, type Lang } from '@/i18n/ui';
import { obtenerProyectos } from '@/lib/contenido';
import { sitio } from '@/lib/sitio';
import { Image } from 'astro:assets';
import { fotos, altFotos } from '@/lib/fotos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const [principal, ...resto] = destacados;
if (!principal) throw new Error('Se necesita al menos un proyecto destacado');
const [segundo, ...demasMovil] = resto;
const urlProyecto = (slug: string) => ruta(lang, `/proyectos/${slug}/`);

const total = proyectos.length;
const [nombre, ...apellidos] = sitio.nombre.split(' ');
const alt = altFotos[lang];
const c = tx(lang, {
  es: {
    descripcion: 'Fabián Rodas, estudiante de Ingeniería en Ciencias de la Computación en Guayaquil. Proyectos que llegan a producción: Lumen, Cifra, Taller y más.',
    saludo: 'Hola, soy',
    intro: 'Estudio Ingeniería en Ciencias de la Computación y hago software que llega a producción: de la interfaz al servidor.',
    datos: ['Guayaquil, Ecuador', 'UEES, me gradúo en 2027', 'Pasantía en Futuresoft'],
    bajar: 'Ver más',
    verProyectos: 'Ver proyectos',
    cv: 'CV en PDF',
    destacados: 'Proyectos destacados',
    destacadosTexto: 'Cinco proyectos que construí, publiqué y sigo manteniendo.',
    destacadosTextoMovil: 'Cinco proyectos que construí y mantengo.',
    verTodos: `Ver los ${total} proyectos`,
    verTodosCorto: `Ver los ${total}`,
    todosLosProyectos: 'Todos los proyectos',
    rolEti: 'Rol',
    anio: 'Año',
    leerCaso: 'Leer el caso de estudio',
    cta: '¿Tienes una vacante o un proyecto?',
    ctaTexto: 'Respondo en uno o dos días, en español o en inglés.',
    respuestaDia: 'Es buena hora: suelo responder hoy mismo.',
    respuestaNoche: 'Es de noche aquí: te respondo mañana por la mañana.',
    enGuayaquil: 'en Guayaquil',
    sobre: 'Sobre mí',
    sobreTexto: 'Me gusta llevar las cosas hasta producción: diseñar la interfaz, escribir el backend, configurar el servidor y seguir publicando versiones. En 2026 hice mi pasantía de desarrollo web en Futuresoft con Flask, React y SQL Server.',
    sobreEnlace: 'Más sobre mí',
  },
  en: {
    descripcion: 'Fabián Rodas, Computer Science Engineering student in Guayaquil, Ecuador. Projects that reach production: Lumen, Cifra, Taller and more.',
    saludo: "Hi, I'm",
    intro: 'I study Computer Science Engineering and build software that reaches production: from the interface to the server.',
    datos: ['Guayaquil, Ecuador', 'UEES, graduating 2027', 'Internship at Futuresoft'],
    bajar: 'See more',
    verProyectos: 'See projects',
    cv: 'CV as PDF',
    destacados: 'Featured projects',
    destacadosTexto: 'Five projects I built, shipped and keep maintaining.',
    destacadosTextoMovil: 'Five projects I built and maintain.',
    verTodos: `See all ${total} projects`,
    verTodosCorto: `See all ${total}`,
    todosLosProyectos: 'All projects',
    rolEti: 'Role',
    anio: 'Year',
    leerCaso: 'Read the case study',
    cta: 'Got an opening or a project?',
    ctaTexto: 'I reply within one or two days, in Spanish or English.',
    respuestaDia: "Good timing: I usually reply the same day.",
    respuestaNoche: "It's night here: I'll reply tomorrow morning.",
    enGuayaquil: 'in Guayaquil',
    sobre: 'About me',
    sobreTexto: 'I like taking things all the way to production: designing the interface, writing the backend, setting up the server and shipping new versions. In 2026 I did my web development internship at Futuresoft with Flask, React and SQL Server.',
    sobreEnlace: 'More about me',
  },
});
---
<Base lang={lang} seccion="inicio" descripcion={c.descripcion}>
  <main id="contenido" class="contenedor inicio">
    <section aria-labelledby="hero-title" class="hero" data-hero>
      <div class="hero__texto">
        <p class="hero__saludo aparecer" style="--i: 0">{c.saludo}</p>
        <h1 id="hero-title" class="hero__nombre">
          <span class="revelar-linea" style="--i: 1"><span>{nombre}</span></span>
          <span class="revelar-linea" style="--i: 2"><span>{apellidos.join(' ')}</span></span>
        </h1>
        <p class="hero__intro aparecer" style="--i: 3">{c.intro}</p>
        <ul class="hero__datos aparecer" style="--i: 4">
          {c.datos.map((d) => <li>{d}</li>)}
        </ul>
        <div class="hero__acciones aparecer" style="--i: 5">
          <a href={ruta(lang, '/proyectos/')} class="btn btn--acento">{c.verProyectos}</a>
          <a href={sitio.cv} class="hero__cv" download><Icono nombre="download" size={16} />{c.cv}</a>
        </div>
      </div>

      <figure class="hero__retrato">
        <span class="hero__panel" aria-hidden="true"></span>
        <Image
          src={fotos.retrato}
          alt={alt.retrato}
          widths={[420, 640, 800]}
          sizes="(max-width: 760px) 86vw, 40vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="hero__foto"
          data-capa="1"
        />
      </figure>
    </section>

    <section aria-labelledby="proyectos-title" class="bloque banda">
      <div class="seccion-cabecera" data-entra>
        <div class="seccion-cabecera__texto">
          <h2 id="proyectos-title" class="h2-grande">{c.destacados}</h2>
          <p class="texto-sec solo-escritorio">{c.destacadosTexto}</p>
          <p class="texto-sec solo-movil movil-sub">{c.destacadosTextoMovil}</p>
        </div>
        <a href={ruta(lang, '/proyectos/')} class="btn btn--sm btn--superficie solo-escritorio">{c.verTodos}</a>
      </div>

      <!-- Escritorio -->
      <div class="solo-escritorio" data-entra>
        <a href={urlProyecto(principal.data.slug)} class="tarjeta destacado">
          <span class="destacado__imagen" data-ui><Shot portada={principal.data.cover} radius="0" lang={lang} /></span>
          <div class="destacado__cuerpo">
            <div class="chips">
              <ChipEstado estado={principal.data.status} lang={lang} grande />
              {principal.data.version && <span class="chip chip--m">v{principal.data.version}</span>}
            </div>
            <h3 class="destacado__titulo">{principal.data.title}</h3>
            <p class="destacado__resumen">{principal.data.homeSummary ?? principal.data.summary}</p>
            <dl class="ficha-mini">
              <dt>{c.rolEti}</dt><dd>{principal.data.role}</dd>
              <dt>{c.anio}</dt><dd>{principal.data.year}</dd>
            </dl>
            <div class="chips">{(principal.data.tags ?? principal.data.stack).map((s) => <span class="chip chip--m">{s}</span>)}</div>
            <span class="destacado__cta">{c.leerCaso}</span>
          </div>
        </a>
      </div>
      <div class="rejilla-4 solo-escritorio" data-entra>
        {resto.map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta mini">
            <span class="mini__imagen" data-ui><Shot portada={p.data.cover} radius="0" lang={lang} /></span>
            <div class="mini__cuerpo">
              <h3 class="mini__titulo">{p.data.title}</h3>
              <ChipEstado estado={p.data.status} lang={lang} />
              <p class="mini__texto">{p.data.tagline}</p>
              <div class="chips">{(p.data.homeTags ?? p.data.stack.slice(0, 2)).map((s) => <span class="chip">{s}</span>)}</div>
            </div>
          </a>
        ))}
      </div>

      <!-- Móvil -->
      {[principal, segundo].filter((p) => p !== undefined).map((p, i) => (
        <a href={urlProyecto(p.data.slug)} class="tarjeta m-proyecto solo-movil">
          <span class="mini__imagen" data-ui><Shot portada={p.data.cover} radius="0" lang={lang} /></span>
          <div class="m-proyecto__cuerpo">
            <div class="mini__fila">
              <h3 class="m-proyecto__titulo">{p.data.title}</h3>
              <ChipEstado estado={p.data.status} lang={lang} />
            </div>
            <p class="mini__texto">{p.data.tagline}</p>
            <div class="chips">
              {(i === 0 ? (p.data.tags ?? p.data.stack).slice(0, 3) : (p.data.homeTags ?? p.data.stack.slice(0, 2))).map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        </a>
      ))}
      <div class="m-rejilla solo-movil">
        {demasMovil.slice(0, 3).map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta m-mini">
            <span class="mini__imagen" data-ui><Shot portada={p.data.cover} radius="0" lang={lang} /></span>
            <span class="m-mini__texto">
              <span class="m-mini__titulo">{p.data.title}</span>
              <span class="m-mini__eti">{p.data.label ?? p.data.tagline}</span>
            </span>
          </a>
        ))}
        <a href={ruta(lang, '/proyectos/')} class="m-todos">
          <span class="m-mini__titulo">{c.verTodosCorto}</span>
          <span class="m-todos__eti">{c.todosLosProyectos}</span>
        </a>
      </div>
    </section>

    <section aria-labelledby="sobre-title" class="sobre">
      <div class="sobre__texto" data-entra>
        <h2 id="sobre-title" class="h2-grande">{c.sobre}</h2>
        <p class="sobre__parrafo">{c.sobreTexto}</p>
        <a href={ruta(lang, '/sobre-mi/')} class="enlace sobre__enlace">{c.sobreEnlace}</a>
      </div>
      <div class="sobre__fotos" data-entra>
        <figure class="sobre__foto sobre__foto--a">
          <Image src={fotos.escritorio} alt={alt.escritorio} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 34vw" format="webp" class="foto-hd" />
        </figure>
        <figure class="sobre__foto sobre__foto--b">
          <Image src={fotos.codigo} alt={alt.codigo} widths={[360, 600, 900]} sizes="(max-width: 760px) 60vw, 22vw" format="webp" class="foto-hd" />
        </figure>
      </div>
    </section>

    <section aria-labelledby="cta-title" class="cta-bloque">
      <div
        class="cta"
        data-entra
        data-reloj
        data-textos={JSON.stringify({ dia: c.respuestaDia, noche: c.respuestaNoche, locale: lang === 'es' ? 'es-EC' : 'en-US' })}
      >
        <Image src={fotos.retrato} alt="" widths={[160]} sizes="80px" format="webp" class="cta__foto" />
        <div class="cta__texto">
          <h2 id="cta-title" class="cta__titulo">{c.cta}</h2>
          <p class="cta__sub"><time class="cta__hora" data-hora>UTC−5</time> {c.enGuayaquil}. <span data-respuesta>{c.ctaTexto}</span></p>
        </div>
        <div class="cta__botones">
          <a href={ruta(lang, '/contacto/')} class="btn btn--acento">{t('escribeme')}</a>
          <button type="button" class="btn cta__copiar" data-copiar={sitio.email} data-copiado={t('emailCopiado')}>
            <Icono nombre="copy" size={16} /><span data-etiqueta>{t('copiarEmail')}</span>
          </button>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .solo-movil { display: none; }

  /* ---------- Hero: texto a la izquierda, retrato recortado saliendo de un panel de tono ---------- */
  .hero {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: end; gap: 40px;
    min-height: min(calc(100svh - 76px), 820px); padding-top: 40px;
  }
  .hero__texto { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 24px; padding-bottom: 88px; }
  .hero__saludo { font-size: var(--t-entrada); color: var(--c-secundario); }
  .hero__nombre {
    display: flex; flex-direction: column;
    font-size: clamp(4.5rem, 2rem + 8vw, 9rem); letter-spacing: -0.045em; line-height: 0.88;
  }
  .hero__intro { max-width: 30em; font-size: var(--t-entrada); line-height: 1.45; color: var(--c-suave); }
  .hero__datos { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .hero__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 4px; }
  .hero__cv { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--c-texto); text-underline-offset: 5px; text-decoration-color: var(--c-punto-inactivo); }
  .hero__cv:hover { text-decoration-color: currentColor; }

  .hero__retrato { position: relative; align-self: stretch; display: flex; align-items: flex-end; justify-content: center; }
  .hero__panel { position: absolute; left: 0; right: 0; bottom: 0; height: 72%; background: var(--c-superficie); }
  .hero__retrato :global(.hero__foto) {
    position: relative; display: block; width: min(92%, 500px); height: auto; max-height: min(80svh, 720px); object-fit: contain; object-position: bottom;
    transform: translate3d(var(--px, 0), 0, 0);
  }

  /* ---------- Proyectos destacados ---------- */
  .bloque.banda { padding-block: 96px; }
  .bloque { display: flex; flex-direction: column; gap: 32px; }
  .destacado__imagen, .mini__imagen { display: block; overflow: hidden; }

  .destacado {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: center;
    padding: 12px 48px 12px 12px;
  }
  .destacado__cuerpo { display: flex; flex-direction: column; gap: 16px; padding: 24px 0; }
  .destacado__titulo { font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3rem); letter-spacing: -0.03em; line-height: 1; }
  .destacado__resumen { color: var(--c-suave); }
  .ficha-mini { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 20px; row-gap: 8px; font-size: var(--t-pequeno); }
  .ficha-mini dt { color: var(--c-secundario); }
  .destacado__cta { align-self: flex-start; margin-top: 8px; color: var(--c-acento-claro); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: transparent; }

  .rejilla-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .mini { gap: 16px; padding: 8px 8px 24px; }
  .mini__cuerpo { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 0 8px; }
  .mini__fila { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; }
  .mini__titulo { font-size: 1.625rem; letter-spacing: -0.02em; line-height: 1.1; }
  .mini__texto { font-size: var(--t-pequeno); color: var(--c-suave); }
  a.tarjeta:hover .destacado__titulo, a.tarjeta:hover .mini__titulo, a.tarjeta:hover .m-proyecto__titulo { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; text-decoration-color: var(--c-acento); }
  a.tarjeta:hover .destacado__cta { text-decoration-color: currentColor; }

  /* ---------- Sobre mí breve ---------- */
  .sobre { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; padding-block: 128px; }
  .sobre__texto { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .sobre__parrafo { font-size: var(--t-entrada); line-height: 1.45; color: var(--c-suave); max-width: 34em; }
  .sobre__enlace { display: inline-flex; align-items: center; min-height: 44px; }
  .sobre__fotos { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 16px; align-items: end; }
  .sobre__foto { overflow: hidden; }
  .sobre__foto--b { margin-bottom: -48px; }
  .sobre__foto :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }
  .sobre__foto--b :global(img) { aspect-ratio: 3 / 4; }

  /* ---------- Banda de contacto ---------- */
  .cta-bloque { padding-block: 48px 120px; }
  .cta {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 32px; align-items: center;
    padding: 40px 48px; background: var(--c-superficie);
  }
  .cta :global(.cta__foto) { width: 80px; height: 80px; object-fit: cover; object-position: 50% 12%; background: var(--c-superficie-2); }
  .cta__texto { display: flex; flex-direction: column; gap: 8px; }
  .cta__titulo { font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.1; }
  .cta__sub { color: var(--c-suave); }
  .cta__hora { color: var(--c-acento-claro); font-variant-numeric: tabular-nums; }
  .cta__botones { display: flex; gap: 12px; }

  /* ---------- Movimiento ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .revelar-linea { display: block; overflow: hidden; padding: 0.14em 0 0.08em; margin-top: -0.14em; }
    .revelar-linea > span { display: block; animation: subir-linea 1100ms var(--ease-salida) both; animation-delay: calc(120ms + var(--i) * 110ms); }
    @keyframes subir-linea { from { transform: translateY(110%); } to { transform: none; } }
    .aparecer { animation: aparecer-hero 900ms var(--ease-salida) both; animation-delay: calc(200ms + var(--i) * 110ms); }
    @keyframes aparecer-hero { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

    .hero__panel { animation: crecer-panel 1200ms var(--ease-salida) 100ms both; transform-origin: bottom; }
    @keyframes crecer-panel { from { transform: scaleY(0); } to { transform: none; } }
    .hero__retrato :global(.hero__foto) { animation: revelar-foto 1400ms var(--ease-salida) 300ms both; }
    @keyframes revelar-foto { from { clip-path: inset(100% 0 0 0); translate: 0 40px; } to { clip-path: inset(0 0 0 0); translate: 0 0; } }

    @supports (animation-timeline: scroll()) {
      .hero__retrato { animation: alejar linear both; animation-timeline: scroll(root); animation-range: 0 90vh; }
      @keyframes alejar { to { opacity: 0.35; transform: translateY(12vh); } }
    }
    .sobre__foto :global(img) { transition: transform 900ms var(--ease-salida); }
    .sobre__foto:hover :global(img) { transform: scale(1.04); }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .rejilla-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1040px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); min-height: 0; }
    .hero__texto { padding-bottom: 56px; }
    .destacado { grid-template-columns: 1fr; padding: 12px 12px 28px; gap: 20px; }
    .destacado__cuerpo { padding: 0 16px; }
    .sobre { grid-template-columns: 1fr; gap: 40px; padding-block: 96px; }
    .cta { grid-template-columns: auto minmax(0, 1fr); }
    .cta__botones { grid-column: 1 / -1; flex-wrap: wrap; }
  }

  /* ---------- Móvil ---------- */
  @media (max-width: 760px) {
    .solo-escritorio { display: none; }
    .solo-movil { display: revert; }
    .inicio { display: flex; flex-direction: column; }

    .hero { display: flex; flex-direction: column; align-items: stretch; gap: 32px; padding-top: 24px; }
    .hero__texto { gap: 18px; padding-bottom: 0; }
    .hero__nombre { font-size: clamp(4rem, 20vw, 5.5rem); }
    .hero__retrato { height: 440px; }
    .hero__retrato :global(.hero__foto) { width: auto; max-height: 440px; }

    .bloque.banda { padding-block: 56px; }
    .bloque { gap: 16px; }
    .movil-sub { font-size: var(--t-pequeno); }
    .m-proyecto { gap: 16px; padding: 8px 8px 20px; }
    .m-proyecto__cuerpo { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
    .m-proyecto__titulo { font-size: 1.625rem; letter-spacing: -0.02em; }
    .m-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .m-mini { gap: 10px; padding: 6px 6px 14px; }
    .m-mini__texto { display: flex; flex-direction: column; padding: 0 6px; }
    .m-mini__titulo { font-size: 1.125rem; }
    .m-mini__eti, .m-todos__eti { font-size: var(--t-pequeno); color: var(--c-secundario); }
    .m-todos {
      display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; padding: 16px;
      background: var(--c-acento); color: var(--c-acento-tinta); text-decoration: none;
    }
    .m-todos .m-todos__eti { color: var(--c-acento-tinta); }

    .sobre { padding-block: 72px; }
    .sobre__foto--b { margin-bottom: -24px; }
    .cta-bloque { padding-block: 32px 72px; }
    .cta { grid-template-columns: 1fr; gap: 20px; padding: 28px 20px; }
    .cta__botones { flex-direction: column; }
    .cta__botones .btn { width: 100%; }
  }
</style>

<script>
  import { iniciarHero } from '@/scripts/hero';
  import { iniciarInicio } from '@/scripts/inicio';
  iniciarHero();
  iniciarInicio();
</script>
