---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import Icono from '@/components/Icono.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import Marquee from '@/components/Marquee.astro';
import { ruta, tx, useT, type Lang } from '@/i18n/ui';
import { obtenerProyectos } from '@/lib/contenido';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const [principal, ...resto] = destacados;
if (!principal) throw new Error('Se necesita al menos un proyecto destacado');
const [segundo, ...demasMovil] = resto;
const urlProyecto = (slug: string) => ruta(lang, `/proyectos/${slug}/`);

const total = proyectos.length;
const [nombre, ...apellidos] = sitio.nombre.split(' ');
const tecnologias = ['React', 'Flask', 'PostgreSQL', 'Rust', 'Astro', 'Angular', 'Express', 'Docker', 'Nginx', 'Linux', 'TypeScript', 'SQL Server'];
const c = tx(lang, {
  es: {
    descripcion: 'Fabián Rodas, estudiante de Ingeniería en Ciencias de la Computación en Guayaquil. Proyectos que llegan a producción: Lumen, Cifra, Taller y más.',
    saludo: 'Hola, soy',
    intro: 'Estudio Ingeniería en Ciencias de la Computación y hago software que llega a producción: de la interfaz al servidor.',
    datos: ['Guayaquil, Ecuador', 'UEES, me gradúo en 2027', 'Pasantía en Futuresoft'],
    estado: 'Ahora: Lumen v1.8',
    marquee: ['Interfaces', 'APIs', 'Servidores', 'Producción', 'Software'],
    stack: 'Tecnologías con las que trabajo',
    bajar: 'Ver más',
    retratoAlt: 'Retrato de Fabián Rodas',
    verProyectos: 'Ver proyectos',
    cv: 'CV en PDF',
    destacados: 'Proyectos destacados',
    destacadosTexto: 'Cinco proyectos que construí, publiqué y sigo manteniendo.',
    destacadosTextoMovil: 'Cinco proyectos que construí y mantengo.',
    verTodos: `Ver los ${total} proyectos`,
    verTodosCorto: `Ver los ${total}`,
    todosLosProyectos: 'Todos los proyectos',
    rolEti: 'Rol',
    anio: 'Año',
    leerCaso: 'Leer el caso de estudio',
    cta: '¿Tienes una vacante o un proyecto?',
    ctaTexto: 'Respondo en uno o dos días, en español o en inglés.',
  },
  en: {
    descripcion: 'Fabián Rodas, Computer Science Engineering student in Guayaquil, Ecuador. Projects that reach production: Lumen, Cifra, Taller and more.',
    saludo: "Hi, I'm",
    intro: 'I study Computer Science Engineering and build software that reaches production: from the interface to the server.',
    datos: ['Guayaquil, Ecuador', 'UEES, graduating 2027', 'Internship at Futuresoft'],
    estado: 'Now: Lumen v1.8',
    marquee: ['Interfaces', 'APIs', 'Servers', 'Production', 'Software'],
    stack: 'Technologies I work with',
    bajar: 'See more',
    retratoAlt: 'Portrait of Fabián Rodas',
    verProyectos: 'See projects',
    cv: 'CV as PDF',
    destacados: 'Featured projects',
    destacadosTexto: 'Five projects I built, shipped and keep maintaining.',
    destacadosTextoMovil: 'Five projects I built and maintain.',
    verTodos: `See all ${total} projects`,
    verTodosCorto: `See all ${total}`,
    todosLosProyectos: 'All projects',
    rolEti: 'Role',
    anio: 'Year',
    leerCaso: 'Read the case study',
    cta: 'Got an opening or a project?',
    ctaTexto: 'I reply within one or two days, in Spanish or English.',
  },
});
---
<Base lang={lang} seccion="inicio" descripcion={c.descripcion}>
  <main id="contenido" class="contenedor inicio">
    <section aria-labelledby="hero-title" class="hero" data-hero>
      <div class="hero__fondo" aria-hidden="true">
        <div class="hero__aurora" data-capa="0.6"><span></span><span></span><span></span></div>
        <Marquee items={c.marquee} class="hero__marquee" duracion={60} />
      </div>

      <div class="hero__texto">
        <p class="hero__saludo revelar-linea" style="--i: 0"><span>{c.saludo}</span></p>
        <h1 id="hero-title" class="hero__nombre">
          <span class="revelar-linea" style="--i: 1"><span>{nombre}</span></span>
          <span class="revelar-linea" style="--i: 2"><span>{apellidos.join(' ')}</span></span>
        </h1>
        <p class="hero__intro aparecer" style="--i: 3">{c.intro}</p>
        <ul class="hero__datos aparecer" style="--i: 4">
          {c.datos.map((d) => <li>{d}</li>)}
        </ul>
        <div class="hero__acciones aparecer" style="--i: 5">
          <a href={ruta(lang, '/proyectos/')} class="btn btn--acento">{c.verProyectos}<Icono nombre="arrow-up-right" size={16} /></a>
          <a href={sitio.cv} class="hero__cv" download><Icono nombre="download" size={16} />{c.cv}</a>
        </div>
      </div>

      <figure class="hero__retrato" data-capa="1">
        <img
          src={sitio.retrato.src}
          alt={c.retratoAlt}
          width={sitio.retrato.width}
          height={sitio.retrato.height}
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="hero__estado">
          <span class="hero__pulso" aria-hidden="true"></span>
          <a href={urlProyecto('lumen')}>{c.estado}</a>
        </figcaption>
      </figure>

      <a href="#stack-title" class="hero__bajar" aria-label={c.bajar}><span></span></a>
    </section>

    <section aria-labelledby="stack-title" class="stack">
      <h2 id="stack-title" class="sr-only">{c.stack}</h2>
      <Marquee items={tecnologias} class="stack__marquee" duracion={45} etiqueta={c.stack} />
      <Marquee items={[...tecnologias].reverse()} class="stack__marquee stack__marquee--2" duracion={55} reversa />
    </section>

    <section aria-labelledby="proyectos-title" class="bloque banda">
      <div class="seccion-cabecera">
        <div class="seccion-cabecera__texto">
          <h2 id="proyectos-title" class="h2-grande">{c.destacados}</h2>
          <p class="texto-sec solo-escritorio">{c.destacadosTexto}</p>
          <p class="texto-sec solo-movil movil-sub">{c.destacadosTextoMovil}</p>
        </div>
        <a href={ruta(lang, '/proyectos/')} class="btn btn--sm btn--superficie solo-escritorio">{c.verTodos}</a>
      </div>

      <!-- Escritorio -->
      <a href={urlProyecto(principal.data.slug)} class="tarjeta destacado solo-escritorio revelar">
        <Shot portada={principal.data.cover} lang={lang} />
        <div class="destacado__cuerpo">
          <div class="chips">
            <ChipEstado estado={principal.data.status} lang={lang} grande />
            {principal.data.version && <span class="chip chip--m">v{principal.data.version}</span>}
          </div>
          <h3 class="destacado__titulo">{principal.data.title}</h3>
          <p class="texto-sec">{principal.data.homeSummary ?? principal.data.summary}</p>
          <dl class="ficha-mini">
            <dt>{c.rolEti}</dt><dd>{principal.data.role}</dd>
            <dt>{c.anio}</dt><dd>{principal.data.year}</dd>
          </dl>
          <div class="chips">{(principal.data.tags ?? principal.data.stack).map((s) => <span class="chip chip--m">{s}</span>)}</div>
          <span class="destacado__cta">{c.leerCaso}</span>
        </div>
      </a>
      <div class="rejilla-4 solo-escritorio">
        {resto.map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta mini revelar">
            <Shot portada={p.data.cover} radius="12px" lang={lang} />
            <div class="mini__cuerpo">
              <div class="mini__fila">
                <h3 class="mini__titulo">{p.data.title}</h3>
                <ChipEstado estado={p.data.status} lang={lang} />
              </div>
              <p class="mini__texto">{p.data.tagline}</p>
              <div class="chips">{(p.data.homeTags ?? p.data.stack.slice(0, 2)).map((s) => <span class="chip">{s}</span>)}</div>
            </div>
          </a>
        ))}
      </div>

      <!-- Móvil -->
      {[principal, segundo].filter((p) => p !== undefined).map((p, i) => (
        <a href={urlProyecto(p.data.slug)} class="tarjeta m-proyecto solo-movil">
          <Shot portada={p.data.cover} radius="13px" lang={lang} />
          <div class="m-proyecto__cuerpo">
            <div class="mini__fila">
              <h3 class="m-proyecto__titulo">{p.data.title}</h3>
              <ChipEstado estado={p.data.status} lang={lang} />
            </div>
            <p class="mini__texto">{p.data.tagline}</p>
            <div class="chips">
              {(i === 0 ? (p.data.tags ?? p.data.stack).slice(0, 3) : (p.data.homeTags ?? p.data.stack.slice(0, 2))).map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        </a>
      ))}
      <div class="m-rejilla solo-movil">
        {demasMovil.slice(0, 3).map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta m-mini">
            <Shot portada={p.data.cover} radius="11px" lang={lang} />
            <span class="m-mini__texto">
              <span class="m-mini__titulo">{p.data.title}</span>
              <span class="m-mini__eti">{p.data.label ?? p.data.tagline}</span>
            </span>
          </a>
        ))}
        <a href={ruta(lang, '/proyectos/')} class="m-todos">
          <span class="m-mini__titulo">{c.verTodosCorto}</span>
          <span class="m-todos__eti">{c.todosLosProyectos}</span>
        </a>
      </div>
    </section>

    <section aria-labelledby="cta-title" class="cta-bloque">
      <div class="cta">
        <span class="cta__avatar">{sitio.iniciales}</span>
        <div class="cta__texto">
          <h2 id="cta-title" class="cta__titulo">{c.cta}</h2>
          <p class="texto-sec">{c.ctaTexto}</p>
        </div>
        <div class="cta__botones">
          <a href={ruta(lang, '/contacto/')} class="btn btn--acento">{t('escribeme')}</a>
          <button type="button" class="btn cta__copiar" data-copiar={sitio.email} data-copiado={t('emailCopiado')}>
            <Icono nombre="copy" size={16} /><span data-etiqueta>{t('copiarEmail')}</span>
          </button>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .solo-movil { display: none; }
  .solo-escritorio-inline { display: inline; }

  /* ---------- Hero (foto recortada + aurora + marquee + revelado con máscara) ---------- */
  .hero {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: end; gap: 32px;
    min-height: min(calc(100svh - 84px), 860px); padding-top: 48px;
  }
  .hero__fondo { position: absolute; inset: -100px calc(50% - 50vw) 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .hero__aurora { position: absolute; inset: -10% 0 0 30%; filter: blur(70px) saturate(1.2); opacity: 0.85; transform: translate3d(var(--px, 0), var(--py, 0), 0); }
  .hero__aurora span { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .hero__aurora span:nth-child(1) { width: 46vmax; height: 46vmax; left: 18%; top: 8%; background: radial-gradient(circle, rgb(159 199 184 / 0.55), transparent 65%); }
  .hero__aurora span:nth-child(2) { width: 30vmax; height: 30vmax; left: 46%; top: 30%; background: radial-gradient(circle, rgb(226 196 126 / 0.28), transparent 65%); }
  .hero__aurora span:nth-child(3) { width: 34vmax; height: 34vmax; left: 6%; top: 44%; background: radial-gradient(circle, rgb(64 120 104 / 0.6), transparent 65%); }
  :global(.hero__marquee) {
    position: absolute; left: 0; right: 0; top: 38%; transform: translateY(-50%) rotate(-4deg);
    --marquee-gap: 4vw;
    font-family: var(--f-titulo); font-size: clamp(96px, 15vw, 230px); font-weight: 700; letter-spacing: -0.04em; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px rgb(227 226 218 / 0.12);
  }
  :global(.hero__marquee .marquee__item::after) { font-size: 0.16em; opacity: 0.5; }

  .hero__texto { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 22px; padding-bottom: 96px; }
  .hero__saludo { font-size: 18px; color: var(--c-acento); }
  .hero__nombre {
    display: flex; flex-direction: column;
    font-family: var(--f-titulo); font-size: clamp(64px, 9vw, 136px); font-weight: 600; letter-spacing: -0.045em; line-height: 0.9;
  }
  .hero__nombre > span:last-child > span { color: transparent; -webkit-text-stroke: 1.5px var(--c-texto); }
  .hero__intro { max-width: 30em; font-size: 17px; line-height: 1.6; color: var(--c-suave); }
  .hero__datos { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; color: var(--c-secundario); }
  .hero__datos li { display: inline-flex; align-items: center; gap: 18px; }
  .hero__datos li + li::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--c-punto-inactivo); margin-left: -12px; }
  .hero__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-top: 6px; }
  .hero__cv { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--c-texto); font-size: 15px; text-underline-offset: 5px; text-decoration-color: var(--c-punto-inactivo); }
  .hero__cv:hover { text-decoration-color: currentColor; }

  .hero__retrato {
    position: relative; z-index: 1; align-self: end; justify-self: center; width: min(100%, 520px);
    transform: perspective(900px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg)) translate3d(var(--px, 0), 0, 0);
    transform-style: preserve-3d;
  }
  .hero__retrato img {
    display: block; width: 100%; height: auto; max-height: min(78svh, 700px); object-fit: contain; object-position: bottom;
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.45));
  }
  .hero__estado {
    position: absolute; left: -12px; bottom: 18%; display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 16px; border-radius: var(--r-pildora); font-size: 14px;
    background: rgb(31 39 37 / 0.7); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    outline: 1px solid var(--c-borde-fuerte); outline-offset: -1px; box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.7);
  }
  .hero__estado a { color: var(--c-texto); text-decoration: none; }
  .hero__estado a:hover { color: var(--c-acento); }
  .hero__pulso { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--c-acento); }
  .hero__pulso::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; }

  .hero__bajar {
    position: absolute; left: 0; bottom: 28px; z-index: 2; display: inline-flex; justify-content: center;
    width: 26px; height: 42px; border-radius: 999px; outline: 1.5px solid var(--c-borde-fuerte); outline-offset: -1.5px;
  }
  .hero__bajar span { width: 3px; height: 8px; margin-top: 9px; border-radius: 3px; background: var(--c-acento); }

  /* Franja de tecnologías */
  .stack { display: flex; flex-direction: column; gap: 10px; padding: 28px 0 96px; }
  :global(.stack__marquee) {
    margin-inline: calc(50% - 50vw); --marquee-gap: 40px;
    font-family: var(--f-titulo); font-size: 28px; font-weight: 600; color: var(--c-secundario);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  :global(.stack__marquee--2) { color: transparent; -webkit-text-stroke: 1px var(--c-punto-inactivo); }

  @media (prefers-reduced-motion: no-preference) {
    /* Revelado con máscara: cada línea sube desde un contenedor con overflow oculto. */
    .revelar-linea { display: block; overflow: hidden; padding-bottom: 0.06em; }
    .revelar-linea > span { display: block; animation: subir-linea 1100ms var(--ease-salida) both; animation-delay: calc(120ms + var(--i) * 110ms); }
    @keyframes subir-linea { from { transform: translateY(110%) rotate(3deg); } to { transform: none; } }
    .aparecer { animation: aparecer-hero 900ms var(--ease-salida) both; animation-delay: calc(200ms + var(--i) * 110ms); }
    @keyframes aparecer-hero { from { opacity: 0; transform: translateY(18px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }

    /* La foto aparece con un clip-path de abajo hacia arriba. */
    .hero__retrato img { animation: revelar-foto 1400ms var(--ease-salida) 250ms both; }
    @keyframes revelar-foto { from { clip-path: inset(100% 0 0 0); transform: translateY(40px) scale(1.04); } to { clip-path: inset(0 0 0 0); transform: none; } }
    .hero__estado { animation: aparecer-hero 900ms var(--ease-salida) 1100ms both; }
    .hero__pulso::after { animation: pulso 2s ease-out infinite; }
    @keyframes pulso { from { transform: scale(1); opacity: 0.6; } to { transform: scale(3); opacity: 0; } }

    /* Aurora que deriva lentamente. */
    .hero__aurora span { animation: derivar 18s ease-in-out infinite alternate; }
    .hero__aurora span:nth-child(2) { animation-duration: 22s; animation-delay: -6s; }
    .hero__aurora span:nth-child(3) { animation-duration: 26s; animation-delay: -12s; }
    @keyframes derivar { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(6%, -8%) scale(1.12); } 100% { transform: translate(-8%, 6%) scale(0.94); } }

    .hero__bajar span { animation: rueda 1.8s var(--ease-salida) infinite; }
    @keyframes rueda { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }

    /* El hero se aleja un poco al hacer scroll. */
    @supports (animation-timeline: scroll()) {
      .hero__fondo { animation: alejar linear both; animation-timeline: scroll(root); animation-range: 0 90vh; }
      @keyframes alejar { to { opacity: 0.25; transform: translateY(18vh) scale(1.08); } }
    }
  }

  /* ---------- Bloques ---------- */
  .bloque.banda { padding-block: 88px 96px; margin-bottom: 112px; }
  .bloque { padding-bottom: 112px; display: flex; flex-direction: column; gap: 28px; }

  .destacado {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: center;
    padding: 10px 40px 10px 10px; border-radius: var(--r-l);
  }
  .destacado__cuerpo { display: flex; flex-direction: column; gap: 16px; padding: 24px 0; }
  .destacado__titulo { font-family: var(--f-titulo); font-size: 30px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .ficha-mini { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 20px; row-gap: 8px; font-size: 14px; }
  .ficha-mini dt { color: var(--c-secundario); }
  .destacado__cta { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 15px; font-weight: 500; color: var(--c-acento); }

  .rejilla-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .mini { gap: 14px; padding: 8px 8px 18px; border-radius: var(--r-card); }
  .mini__cuerpo { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
  .mini__fila { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .mini__titulo { font-family: var(--f-titulo); font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  .mini__texto { font-size: 14px; color: var(--c-secundario); }

  /* ---------- CTA ---------- */
  .cta-bloque { padding-bottom: 112px; }
  .cta {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 28px; align-items: center;
    padding: 36px 40px; border-radius: var(--r-xl); background: var(--c-superficie);
  }
  .cta__avatar {
    display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 50%;
    background: var(--c-superficie-2); font-family: var(--f-titulo); font-size: 22px; font-weight: 600; color: var(--c-acento);
  }
  .cta__texto { display: flex; flex-direction: column; gap: 6px; }
  .cta__titulo { font-family: var(--f-titulo); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  .cta__botones { display: flex; gap: 12px; }
  .cta__copiar { padding: 0 20px; font-weight: 400; }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .rejilla-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1040px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); min-height: 0; padding-top: 40px; }
    .hero__texto { padding-bottom: 72px; }
    .hero__bajar { display: none; }
    .destacado { grid-template-columns: 1fr; padding: 10px 10px 24px; gap: 20px; }
    .destacado__cuerpo { padding: 0 14px; }
    .cta { grid-template-columns: auto minmax(0, 1fr); }
    .cta__botones { grid-column: 1 / -1; flex-wrap: wrap; }
  }

  /* ---------- Móvil (HomeMobile.dc.html) ---------- */
  @media (max-width: 760px) {
    .solo-escritorio, .solo-escritorio-grid { display: none; }
    .solo-escritorio-inline { display: none; }
    .solo-movil { display: revert; }
    .inicio { padding: 0 20px 64px; display: flex; flex-direction: column; gap: 64px; }

    .hero { display: flex; flex-direction: column; align-items: stretch; gap: 8px; padding-top: 24px; }
    .hero__texto { gap: 16px; padding-bottom: 0; }
    .hero__saludo { font-size: 16px; }
    .hero__nombre { font-size: clamp(56px, 18vw, 76px); }
    .hero__intro { font-size: 16px; }
    .hero__datos { font-size: 13px; }
    .hero__acciones .btn { height: 48px; }
    .hero__retrato { width: min(86%, 360px); margin-top: 12px; }
    .hero__retrato img { max-height: 440px; }
