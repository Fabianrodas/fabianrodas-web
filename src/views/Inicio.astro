---
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import Icono from '@/components/Icono.astro';
import ChipEstado from '@/components/ChipEstado.astro';
import { ruta, tx, useT, type Lang } from '@/i18n/ui';
import { obtenerProyectos } from '@/lib/contenido';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const [principal, ...resto] = destacados;
if (!principal) throw new Error('Se necesita al menos un proyecto destacado');
const [segundo, ...demasMovil] = resto;
const urlProyecto = (slug: string) => ruta(lang, `/proyectos/${slug}/`);

const total = proyectos.length;
const c = tx(lang, {
  es: {
    descripcion: 'Fabián Rodas, estudiante de Ingeniería en Ciencias de la Computación en Guayaquil. Proyectos que llegan a producción: Lumen, Cifra, Taller y más.',
    lugar: 'Guayaquil, Ecuador',
    rol: 'Estudiante de Ingeniería en Ciencias de la Computación',
    intro1: 'Hago software y me gusta llevarlo hasta producción. Hoy mantengo',
    intro2: ', el álbum donde mi familia guarda sus fotos, en un servidor que administro yo, y estoy escribiendo',
    intro3: 'en Rust para cifrar archivos antes de subirlos a la nube.',
    verProyectos: 'Ver proyectos',
    cv: 'CV en PDF',
    ficha: 'En resumen',
    ahora: 'Ahora',
    ahoraValor: 'Lumen v1.8',
    ahoraDetalle: 'Respaldo físico y cuentas desactivadas',
    progreso: 'Progreso de Lumen v1.8',
    estudio: 'Estudio',
    estudioValor: 'UEES, séptimo semestre',
    estudioDetalle: 'Me gradúo en 2027',
    antes: 'Antes',
    antesValor: 'Pasantía en Futuresoft',
    antesDetalle: 'Flask, React y SQL Server, 2026',
    busco: 'Busco',
    buscoValor: 'Prácticas desde enero de 2027',
    destacados: 'Proyectos destacados',
    destacadosTexto: 'Cinco proyectos que construí, publiqué y sigo manteniendo.',
    destacadosTextoMovil: 'Cinco proyectos que construí y mantengo.',
    verTodos: `Ver los ${total} proyectos`,
    verTodosCorto: `Ver los ${total}`,
    todosLosProyectos: 'Todos los proyectos',
    rolEti: 'Rol',
    anio: 'Año',
    leerCaso: 'Leer el caso de estudio',
    cta: '¿Tienes una vacante o un proyecto?',
    ctaTexto: 'Respondo en uno o dos días, en español o en inglés.',
  },
  en: {
    descripcion: 'Fabián Rodas, Computer Science Engineering student in Guayaquil, Ecuador. Projects that reach production: Lumen, Cifra, Taller and more.',
    lugar: 'Guayaquil, Ecuador',
    rol: 'Computer Science Engineering student',
    intro1: 'I build software and I like taking it all the way to production. Right now I maintain',
    intro2: ', the album where my family keeps its photos, on a server I run myself, and I am writing',
    intro3: 'in Rust to encrypt files before they reach the cloud.',
    verProyectos: 'See projects',
    cv: 'CV as PDF',
    ficha: 'At a glance',
    ahora: 'Now',
    ahoraValor: 'Lumen v1.8',
    ahoraDetalle: 'Physical backup and deactivated accounts',
    progreso: 'Lumen v1.8 progress',
    estudio: 'Studying',
    estudioValor: 'UEES, seventh semester',
    estudioDetalle: 'Graduating in 2027',
    antes: 'Before',
    antesValor: 'Internship at Futuresoft',
    antesDetalle: 'Flask, React and SQL Server, 2026',
    busco: 'Looking for',
    buscoValor: 'Internships from January 2027',
    destacados: 'Featured projects',
    destacadosTexto: 'Five projects I built, shipped and keep maintaining.',
    destacadosTextoMovil: 'Five projects I built and maintain.',
    verTodos: `See all ${total} projects`,
    verTodosCorto: `See all ${total}`,
    todosLosProyectos: 'All projects',
    rolEti: 'Role',
    anio: 'Year',
    leerCaso: 'Read the case study',
    cta: 'Got an opening or a project?',
    ctaTexto: 'I reply within one or two days, in Spanish or English.',
  },
});
---
<Base lang={lang} seccion="inicio" descripcion={c.descripcion}>
  <main id="contenido" class="contenedor inicio">
    <section aria-labelledby="hero-title" class="hero">
      <p class="hero__linea entrada-sola"><span>{c.rol}</span><span class="hero__sep" aria-hidden="true">·</span><span>{c.lugar}</span></p>
      <div class="hero__cuerpo">
        <div class="hero__texto entrada">
          <h1 id="hero-title" class="hero__nombre">{sitio.nombre}</h1>
          <p class="hero__intro">
            {c.intro1} <a href={urlProyecto('lumen')}>Lumen</a>{c.intro2} <a href={urlProyecto('cifra')}>Cifra</a> {c.intro3}
          </p>
          <ul class="hero__enlaces">
            <li><a href={ruta(lang, '/proyectos/')} class="hero__enlace hero__enlace--principal">{c.verProyectos}<Icono nombre="arrow-up-right" size={16} /></a></li>
            <li><a href={sitio.cv} class="hero__enlace" download>{c.cv}</a></li>
            <li><a href={`mailto:${sitio.email}`} class="hero__enlace">{sitio.email}</a></li>
          </ul>
        </div>
        <dl class="ficha entrada" aria-label={c.ficha}>
          <div class="ficha__fila">
            <dt>{c.ahora}</dt>
            <dd>
              <a href={urlProyecto('lumen')} class="ficha__valor">{c.ahoraValor}</a>
              <span class="ficha__detalle">{c.ahoraDetalle}</span>
              <span class="ficha__progreso">
                <span class="ficha__barra" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" aria-label={c.progreso}><span style="width: 60%"></span></span>
                60 %
              </span>
            </dd>
          </div>
          <div class="ficha__fila">
            <dt>{c.estudio}</dt>
            <dd><span class="ficha__valor">{c.estudioValor}</span><span class="ficha__detalle">{c.estudioDetalle}</span></dd>
          </div>
          <div class="ficha__fila">
            <dt>{c.antes}</dt>
            <dd><span class="ficha__valor">{c.antesValor}</span><span class="ficha__detalle">{c.antesDetalle}</span></dd>
          </div>
          <div class="ficha__fila">
            <dt>{c.busco}</dt>
            <dd><span class="ficha__valor ficha__valor--acento"><span class="ficha__punto" aria-hidden="true"></span>{c.buscoValor}</span><a href={ruta(lang, '/contacto/')} class="ficha__detalle ficha__detalle--enlace">{t('escribeme')}</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <section aria-labelledby="proyectos-title" class="bloque">
      <div class="seccion-cabecera">
        <div class="seccion-cabecera__texto">
          <h2 id="proyectos-title" class="h2-grande">{c.destacados}</h2>
          <p class="texto-sec solo-escritorio">{c.destacadosTexto}</p>
          <p class="texto-sec solo-movil movil-sub">{c.destacadosTextoMovil}</p>
        </div>
        <a href={ruta(lang, '/proyectos/')} class="btn btn--sm btn--superficie solo-escritorio">{c.verTodos}</a>
      </div>

      <!-- Escritorio -->
      <a href={urlProyecto(principal.data.slug)} class="tarjeta destacado solo-escritorio revelar">
        <Shot portada={principal.data.cover} lang={lang} />
        <div class="destacado__cuerpo">
          <div class="chips">
            <ChipEstado estado={principal.data.status} lang={lang} grande />
            {principal.data.version && <span class="chip chip--m">v{principal.data.version}</span>}
          </div>
          <h3 class="destacado__titulo">{principal.data.title}</h3>
          <p class="texto-sec">{principal.data.homeSummary ?? principal.data.summary}</p>
          <dl class="ficha-mini">
            <dt>{c.rolEti}</dt><dd>{principal.data.role}</dd>
            <dt>{c.anio}</dt><dd>{principal.data.year}</dd>
          </dl>
          <div class="chips">{(principal.data.tags ?? principal.data.stack).map((s) => <span class="chip chip--m">{s}</span>)}</div>
          <span class="destacado__cta">{c.leerCaso}</span>
        </div>
      </a>
      <div class="rejilla-4 solo-escritorio">
        {resto.map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta mini revelar">
            <Shot portada={p.data.cover} radius="12px" lang={lang} />
            <div class="mini__cuerpo">
              <div class="mini__fila">
                <h3 class="mini__titulo">{p.data.title}</h3>
                <ChipEstado estado={p.data.status} lang={lang} />
              </div>
              <p class="mini__texto">{p.data.tagline}</p>
              <div class="chips">{(p.data.homeTags ?? p.data.stack.slice(0, 2)).map((s) => <span class="chip">{s}</span>)}</div>
            </div>
          </a>
        ))}
      </div>

      <!-- Móvil -->
      {[principal, segundo].filter((p) => p !== undefined).map((p, i) => (
        <a href={urlProyecto(p.data.slug)} class="tarjeta m-proyecto solo-movil">
          <Shot portada={p.data.cover} radius="13px" lang={lang} />
          <div class="m-proyecto__cuerpo">
            <div class="mini__fila">
              <h3 class="m-proyecto__titulo">{p.data.title}</h3>
              <ChipEstado estado={p.data.status} lang={lang} />
            </div>
            <p class="mini__texto">{p.data.tagline}</p>
            <div class="chips">
              {(i === 0 ? (p.data.tags ?? p.data.stack).slice(0, 3) : (p.data.homeTags ?? p.data.stack.slice(0, 2))).map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        </a>
      ))}
      <div class="m-rejilla solo-movil">
        {demasMovil.slice(0, 3).map((p) => (
          <a href={urlProyecto(p.data.slug)} class="tarjeta m-mini">
            <Shot portada={p.data.cover} radius="11px" lang={lang} />
            <span class="m-mini__texto">
              <span class="m-mini__titulo">{p.data.title}</span>
              <span class="m-mini__eti">{p.data.label ?? p.data.tagline}</span>
            </span>
          </a>
        ))}
        <a href={ruta(lang, '/proyectos/')} class="m-todos">
          <span class="m-mini__titulo">{c.verTodosCorto}</span>
          <span class="m-todos__eti">{c.todosLosProyectos}</span>
        </a>
      </div>
    </section>

    <section aria-labelledby="cta-title" class="cta-bloque">
      <div class="cta">
        <span class="cta__avatar">{sitio.iniciales}</span>
        <div class="cta__texto">
          <h2 id="cta-title" class="cta__titulo">{c.cta}</h2>
          <p class="texto-sec">{c.ctaTexto}</p>
        </div>
        <div class="cta__botones">
          <a href={ruta(lang, '/contacto/')} class="btn btn--acento">{t('escribeme')}</a>
          <button type="button" class="btn cta__copiar" data-copiar={sitio.email} data-copiado={t('emailCopiado')}>
            <Icono nombre="copy" size={16} /><span data-etiqueta>{t('copiarEmail')}</span>
          </button>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .solo-movil { display: none; }
  .solo-escritorio-inline { display: inline; }

  /* ---------- Hero ---------- */
  .hero { padding: 72px 0 104px; display: flex; flex-direction: column; gap: 40px; }
  .hero__linea {
    display: flex; flex-wrap: wrap; gap: 4px 12px; padding-bottom: 20px; border-bottom: 1px solid var(--c-superficie-2);
    font-size: 15px; color: var(--c-secundario);
  }
  .hero__sep { color: var(--c-punto-inactivo); }
  .hero__cuerpo { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 72px; align-items: end; }
  .hero__texto { display: flex; flex-direction: column; gap: 28px; }
  .hero__nombre {
    font-family: var(--f-titulo); font-size: clamp(56px, 8.4vw, 112px); font-weight: 600;
    letter-spacing: -0.035em; line-height: 0.95; margin-left: -0.03em;
  }
  .hero__intro { max-width: 34em; font-size: 21px; line-height: 1.5; color: var(--c-suave); }
  .hero__intro a { color: var(--c-texto); text-decoration-color: var(--c-acento); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .hero__intro a:hover { color: var(--c-acento); }
  .hero__enlaces { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-size: 15px; }
  .hero__enlace {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    color: var(--c-secundario); text-decoration: underline; text-decoration-color: var(--c-punto-inactivo); text-underline-offset: 5px;
  }
  .hero__enlace:hover { color: var(--c-texto); text-decoration-color: currentColor; }
  .hero__enlace--principal { color: var(--c-acento); font-weight: 500; text-decoration-color: currentColor; }

  .ficha { display: flex; flex-direction: column; border-top: 1px solid var(--c-superficie-2); }
  .ficha__fila {
    display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; padding: 18px 0;
    border-bottom: 1px solid var(--c-superficie-2);
  }
  .ficha dt { font-size: 14px; color: var(--c-secundario); padding-top: 2px; }
  .ficha dd { display: flex; flex-direction: column; gap: 4px; }
  .ficha__valor { display: inline-flex; align-items: center; gap: 8px; font-size: 17px; font-weight: 500; color: var(--c-texto); text-decoration: none; }
  a.ficha__valor:hover { color: var(--c-acento); }
  .ficha__valor--acento { color: var(--c-acento); }
  .ficha__punto { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .ficha__detalle { font-size: 14px; color: var(--c-secundario); }
  .ficha__detalle--enlace { align-self: flex-start; color: var(--c-texto); text-underline-offset: 4px; }
  .ficha__progreso { display: flex; align-items: center; gap: 10px; padding-top: 6px; font-size: 13px; color: var(--c-secundario); }
  .ficha__barra { flex: 1; max-width: 200px; height: 4px; border-radius: var(--r-pildora); background: var(--c-superficie-2); overflow: hidden; }
  .ficha__barra span { display: block; height: 100%; background: var(--c-acento); }

  @media (prefers-reduced-motion: no-preference) {
    .entrada-sola { animation: entrar-hero 600ms var(--ease) both; }
    @keyframes entrar-hero { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  }

  /* ---------- Bloques ---------- */
  .bloque { padding-bottom: 112px; display: flex; flex-direction: column; gap: 28px; }

  .destacado {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: center;
    padding: 10px 40px 10px 10px; border-radius: var(--r-l);
  }
  .destacado__cuerpo { display: flex; flex-direction: column; gap: 16px; padding: 24px 0; }
  .destacado__titulo { font-family: var(--f-titulo); font-size: 30px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .ficha-mini { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 20px; row-gap: 8px; font-size: 14px; }
  .ficha-mini dt { color: var(--c-secundario); }
  .destacado__cta { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 15px; font-weight: 500; color: var(--c-acento); }

  .rejilla-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .mini { gap: 14px; padding: 8px 8px 18px; border-radius: var(--r-card); }
  .mini__cuerpo { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
  .mini__fila { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .mini__titulo { font-family: var(--f-titulo); font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  .mini__texto { font-size: 14px; color: var(--c-secundario); }

  /* ---------- CTA ---------- */
  .cta-bloque { padding-bottom: 112px; }
  .cta {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 28px; align-items: center;
    padding: 36px 40px; border-radius: var(--r-xl); background: var(--c-superficie);
  }
  .cta__avatar {
    display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 50%;
    background: var(--c-superficie-2); font-family: var(--f-titulo); font-size: 22px; font-weight: 600; color: var(--c-acento);
  }
  .cta__texto { display: flex; flex-direction: column; gap: 6px; }
  .cta__titulo { font-family: var(--f-titulo); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  .cta__botones { display: flex; gap: 12px; }
  .cta__copiar { padding: 0 20px; font-weight: 400; }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .rejilla-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero__cuerpo { gap: 48px; }
  }
  @media (max-width: 1040px) {
    .hero { padding: 48px 0 88px; }
    .hero__cuerpo { grid-template-columns: 1fr; gap: 40px; }
    .destacado { grid-template-columns: 1fr; padding: 10px 10px 24px; gap: 20px; }
    .destacado__cuerpo { padding: 0 14px; }
    .cta { grid-template-columns: auto minmax(0, 1fr); }
    .cta__botones { grid-column: 1 / -1; flex-wrap: wrap; }
  }

  /* ---------- Móvil (HomeMobile.dc.html) ---------- */
  @media (max-width: 760px) {
    .solo-escritorio, .solo-escritorio-grid { display: none; }
    .solo-escritorio-inline { display: none; }
    .solo-movil { display: revert; }
    .inicio { padding: 0 20px 64px; display: flex; flex-direction: column; gap: 64px; }

    .hero { padding: 24px 0 0; gap: 28px; }
    .hero__linea { flex-direction: column; gap: 2px; padding-bottom: 16px; font-size: 14px; }
    .hero__sep { display: none; }
    .hero__texto { gap: 20px; }
    .hero__nombre { font-size: 52px; }
    .hero__intro { font-size: 17px; line-height: 1.55; }
    .hero__enlaces { gap: 0 20px; }
    .ficha__fila { grid-template-columns: 76px minmax(0, 1fr); gap: 12px; padding: 14px 0; }
    .ficha__valor { font-size: 16px; }

    .bloque { padding: 0; gap: 16px; }
    .seccion-cabecera { gap: 4px; }
    .seccion-cabecera__texto { gap: 4px; }
    .h2-grande { line-height: 1.55; }
    .movil-sub { font-size: 15px; }

    .m-proyecto { display: flex; gap: 14px; padding: 8px 8px 18px; border-radius: var(--r-m); }
    .m-proyecto__cuerpo { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
    .m-proyecto__titulo { font-family: var(--f-titulo); font-size: 21px; font-weight: 600; }
    .m-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .m-mini { display: flex; gap: 10px; padding: 6px 6px 14px; border-radius: var(--r-card); }
    .m-mini__texto { display: flex; flex-direction: column; gap: 2px; padding: 0 6px; }
    .m-mini__titulo { font-family: var(--f-titulo); font-size: 17px; font-weight: 600; }
    .m-mini__eti { font-size: 13px; color: var(--c-secundario); }
    .m-todos {
      display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; padding: 14px;
      border-radius: var(--r-card); background: var(--c-fondo-acento); color: var(--c-acento); text-decoration: none; text-align: center;
    }
    .m-todos__eti { font-size: 13px; color: var(--c-suave-acento); }

    .cta-bloque { padding: 0; }
    .cta { display: flex; flex-direction: column; align-items: stretch; gap: 14px; padding: 24px; border-radius: var(--r-l); }
    .cta__avatar { width: 56px; height: 56px; font-size: 18px; }
    .cta__texto { gap: 14px; }
    .cta__titulo { font-size: 22px; letter-spacing: 0; }
    .cta__texto p { font-size: 15px; }
    .cta__botones { display: flex; }
    .cta__botones .btn--acento { flex: 1; height: 48px; }
    .cta__copiar { display: none; }
  }
</style>
