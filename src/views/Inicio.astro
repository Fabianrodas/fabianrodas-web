---
/*
 * Inicio — dirección "Sala oscura" (docs/superpowers/specs/2026-10-22-sala-oscura-design.md).
 * Hero: foto inset a la izquierda y el nombre en minúsculas que la cruza.
 * Proyectos: nombres grandes con vista fija. Sobre mí: datos al lado, párrafo ancho.
 * Contacto: la hora de Guayaquil como pieza iluminada y una tarjeta con los canales.
 */
import Base from '@/layouts/Base.astro';
import Shot from '@/components/Shot.astro';
import { ruta, tx, type Lang } from '@/i18n/ui';
import { obtenerProyectos, type Proyecto } from '@/lib/contenido';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const proyectos = await obtenerProyectos(lang);
const destacados = proyectos.filter((p) => p.data.featured);
const total = proyectos.length;
const urlProyecto = (slug: string) => ruta(lang, `/proyectos/${slug}/`);

const c = tx(lang, {
  es: {
    descripcion: 'Fabián Rodas, estudiante de Ingeniería en Ciencias de la Computación en Guayaquil. Hago software que llega a producción.',
    frase: 'Estudio Ingeniería en Ciencias de la Computación en Guayaquil y hago software que llega a producción.',
    verProyectos: 'Ver proyectos',
    cv: 'Descargar CV',
    retratoAlt: 'Fabián Rodas',
    proyectos: 'Proyectos',
    proyectosTexto: 'Cinco que construí y sigo manteniendo, de un álbum familiar en mi propio servidor a la página de un taller de Guayaquil.',
    verTodos: `Ver los ${total} proyectos`,
    estado: { produccion: 'En producción', desarrollo: 'En desarrollo', archivado: 'Archivado' },
    sobre: 'Sobre mí',
    parrafo:
      'Me gusta llevar las cosas hasta producción: diseñar la interfaz, escribir el backend, configurar el servidor y seguir publicando versiones. Así nació Lumen, el álbum donde mi familia guarda sus fotos, y así estoy construyendo Cifra en Rust. En 2026 hice mi pasantía de desarrollo web en Futuresoft con Flask, React y SQL Server.',
    masSobre: 'Más sobre mí',
    datos: [
      ['Vivo en', 'Guayaquil, Ecuador'],
      ['Estudio en', 'UEES, séptimo semestre'],
      ['Me gradúo en', '2027'],
      ['Hablo', 'Español e inglés (B2)'],
    ],
    contacto: 'Escríbeme',
    contactoTexto: 'Busco prácticas desde enero de 2027 y acepto proyectos pequeños para negocios locales.',
    enGuayaquil: 'en Guayaquil',
    respuestaFija: 'Respondo en uno o dos días, en español o en inglés.',
    respuestaDia: 'Es buena hora: suelo responder hoy mismo.',
    respuestaNoche: 'Es de noche aquí: te respondo mañana por la mañana.',
    copiarEmail: 'Copiar',
    emailCopiado: 'Email copiado',
    mensaje: 'Enviar un mensaje',
  },
  en: {
    descripcion: 'Fabián Rodas, Computer Science Engineering student in Guayaquil, Ecuador. I build software that reaches production.',
    frase: 'I study Computer Science Engineering in Guayaquil, Ecuador, and build software that reaches production.',
    verProyectos: 'See projects',
    cv: 'Download CV',
    retratoAlt: 'Fabián Rodas',
    proyectos: 'Projects',
    proyectosTexto: 'Five I built and keep maintaining, from a family album on my own server to the website of a repair shop in Guayaquil.',
    verTodos: `See all ${total} projects`,
    estado: { produccion: 'In production', desarrollo: 'In development', archivado: 'Archived' },
    sobre: 'About me',
    parrafo:
      "I like taking things all the way to production: designing the interface, writing the backend, setting up the server and shipping new versions. That's how Lumen was born, the album where my family keeps its photos, and how I'm building Cifra in Rust. In 2026 I did my web development internship at Futuresoft with Flask, React and SQL Server.",
    masSobre: 'More about me',
    datos: [
      ['I live in', 'Guayaquil, Ecuador'],
      ['I study at', 'UEES, seventh semester'],
      ['I graduate in', '2027'],
      ['I speak', 'Spanish and English (B2)'],
    ],
    contacto: 'Write to me',
    contactoTexto: "I'm looking for an internship from January 2027 and take on small projects for local businesses.",
    enGuayaquil: 'in Guayaquil',
    respuestaFija: 'I reply within one or two days, in Spanish or English.',
    respuestaDia: 'Good timing: I usually reply the same day.',
    respuestaNoche: "It's night here: I'll reply tomorrow morning.",
    copiarEmail: 'Copy',
    emailCopiado: 'Email copied',
    mensaje: 'Send a message',
  },
});

const meta = (p: Proyecto) => `${c.estado[p.data.status]} · ${p.data.stack.slice(0, 3).join(', ')} · ${p.data.year}`;
const nombreHero = sitio.nombre.toLowerCase();
---
<Base lang={lang} seccion="inicio" descripcion={c.descripcion}>
  <main id="contenido" class="inicio">
    <section aria-labelledby="hero-title" class="hero" data-hero>
      <figure class="hero__foto">
        <img
          src={sitio.retrato.src}
          alt={c.retratoAlt}
          width={sitio.retrato.width}
          height={sitio.retrato.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="hero__texto entrada">
        <p class="hero__frase">{c.frase}</p>
        <div class="hero__acciones">
          <a href={ruta(lang, '/proyectos/')} class="btn btn--acento">{c.verProyectos}</a>
          <a href={sitio.cv} class="enlace hero__cv" download>{c.cv}</a>
        </div>
      </div>
      <h1 id="hero-title" class="hero__nombre"><span>{nombreHero}</span></h1>
    </section>

    <section aria-labelledby="proyectos-title" class="trabajo contenedor" data-trabajo>
      <div class="trabajo__cabeza" data-entra>
        <h2 id="proyectos-title" class="h2-grande">{c.proyectos}</h2>
        <p class="trabajo__texto">{c.proyectosTexto}</p>
      </div>
      <div class="trabajo__cuerpo">
        <ol class="trabajo__lista" data-entra>
          {destacados.map((p, i) => (
            <li class="trabajo__item">
              <a href={urlProyecto(p.data.slug)} class:list={['trabajo__enlace', { activo: i === 0 }]} data-vista={p.data.slug}>
                <span class="trabajo__nombre">{p.data.title}</span>
                <span class="trabajo__meta">{p.data.tagline} <span class="trabajo__datos">{meta(p)}</span></span>
              </a>
              <div class="trabajo__vista-movil" data-ui>
                <Shot portada={p.data.cover} lang={lang} />
              </div>
            </li>
          ))}
        </ol>
        <div class="trabajo__vista" aria-hidden="true">
          <div class="trabajo__marco">
            {destacados.map((p, i) => (
              <div class:list={['trabajo__captura', { activa: i === 0 }]} data-captura={p.data.slug} data-ui>
                <Shot portada={p.data.cover} lang={lang} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <a href={ruta(lang, '/proyectos/')} class="enlace trabajo__todos">{c.verTodos}</a>
    </section>

    <section aria-labelledby="sobre-title" class="sobre contenedor">
      <dl class="sobre__datos" data-entra>
        {c.datos.map(([eti, valor]) => (
          <div class="sobre__dato"><dt>{eti}</dt><dd>{valor}</dd></div>
        ))}
      </dl>
      <div class="sobre__texto" data-entra>
        <h2 id="sobre-title" class="h2-grande">{c.sobre}</h2>
        <p class="sobre__parrafo">{c.parrafo}</p>
        <a href={ruta(lang, '/sobre-mi/')} class="enlace sobre__mas">{c.masSobre}</a>
      </div>
    </section>

    <section
      aria-labelledby="contacto-title"
      class="contacto"
      data-reloj
      data-textos={JSON.stringify({ dia: c.respuestaDia, noche: c.respuestaNoche, locale: lang === 'es' ? 'es-EC' : 'en-US' })}
    >
      <div class="contacto__interior contenedor">
        <p class="contacto__hora">
          <time class="contacto__reloj" data-hora>UTC−5</time>
          <span class="contacto__lugar">{c.enGuayaquil}</span>
        </p>
        <div class="contacto__tarjeta" data-entra>
          <h2 id="contacto-title" class="contacto__titulo">{c.contacto}</h2>
          <p class="contacto__texto">{c.contactoTexto}</p>
          <p class="contacto__respuesta" data-respuesta>{c.respuestaFija}</p>
          <ul class="contacto__canales">
            <li>
              <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
              <button type="button" class="contacto__copiar" data-copiar={sitio.email} data-copiado={c.emailCopiado}><span data-etiqueta>{c.copiarEmail}</span></button>
            </li>
            <li><a href={sitio.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href={sitio.github} target="_blank" rel="noopener">GitHub</a></li>
          </ul>
          <a href={ruta(lang, '/contacto/')} class="btn btn--acento contacto__boton">{c.mensaje}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { iniciarInicio } from '@/scripts/inicio';
  iniciarInicio();
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid; grid-template-columns: 47% minmax(0, 1fr);
    height: calc(100svh - 76px); min-height: 620px; max-height: 1000px;
    padding: 20px 0 20px 20px;
  }
  .hero__foto { position: relative; overflow: hidden; background: var(--c-superficie); }
  .hero__foto img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    filter: brightness(0.78) contrast(1.05) saturate(0.8);
  }
  .hero__texto {
    align-self: start; justify-self: center; margin-top: 26svh;
    display: flex; flex-direction: column; gap: 32px; max-width: 34ch; padding: 0 var(--gutter);
    box-sizing: content-box;
  }
  .hero__frase { font-size: var(--t-entrada); line-height: 1.3; color: var(--c-texto); }
  .hero__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .hero__cv { font-size: var(--t-pequeno); display: inline-flex; min-height: 44px; align-items: center; }
  .hero__nombre {
    position: absolute; left: 37vw; right: var(--gutter); bottom: 40px; z-index: 2;
    font-family: var(--f-titulo); font-size: min(11.4vw, 13rem); font-weight: 300;
    letter-spacing: -0.04em; line-height: 0.85; white-space: nowrap; color: var(--c-texto);
    pointer-events: none;
  }
  .hero__nombre span { display: inline-block; transform-origin: left bottom; }

  /* ---------- Proyectos: nombres grandes, vista fija ---------- */
  .trabajo { padding-top: 200px; display: flex; flex-direction: column; gap: 56px; }
  .trabajo__cabeza { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px; align-items: end; }
  .trabajo__texto { color: var(--c-suave); max-width: 36ch; }
  .trabajo__cuerpo { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 48px; align-items: start; }
  .trabajo__lista { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .trabajo__enlace {
    display: flex; flex-direction: column; gap: 6px; padding: 18px 0;
    color: var(--c-texto); text-decoration: none;
  }
  .trabajo__nombre {
    font-family: var(--f-titulo); font-size: clamp(2.75rem, 5.4vw, 5rem); font-weight: 300;
    letter-spacing: -0.035em; line-height: 1; transition: color 300ms;
  }
  .trabajo__meta { font-size: var(--t-pequeno); color: var(--c-suave); max-width: 60ch; }
  .trabajo__datos { display: block; color: var(--c-secundario); }
  .trabajo__lista:hover .trabajo__enlace:not(:hover) .trabajo__nombre { color: var(--c-secundario); }
  .trabajo__vista { position: sticky; top: calc(50svh - 18vw); }
  .trabajo__marco { position: relative; aspect-ratio: 16 / 10; background: var(--c-superficie); overflow: hidden; }
  .trabajo__captura { position: absolute; inset: 0; opacity: 0; transition: opacity 500ms var(--ease-salida); }
  .trabajo__captura.activa { opacity: 1; }
  .trabajo__captura :global(.shot) { height: 100%; aspect-ratio: auto !important; }
  .trabajo__vista-movil { display: none; }
  .trabajo__todos { align-self: flex-start; font-size: var(--t-pequeno); min-height: 44px; display: inline-flex; align-items: center; }

  /* ---------- Sobre mí: datos al lado, párrafo ancho ---------- */
  .sobre { padding-top: 200px; display: grid; grid-template-columns: minmax(0, 34fr) minmax(0, 66fr); gap: 32px; }
  .sobre__datos { display: flex; flex-direction: column; gap: 20px; padding-top: 12px; }
  .sobre__dato dt { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .sobre__dato dd { font-size: var(--t-cuerpo); }
  .sobre__texto { display: flex; flex-direction: column; gap: 32px; align-items: flex-start; }
  .sobre__parrafo { font-size: var(--t-entrada); line-height: 1.4; max-width: 40ch; }
  .sobre__mas { font-size: var(--t-pequeno); min-height: 44px; display: inline-flex; align-items: center; }

  /* ---------- Contacto: la hora de Guayaquil, iluminada ---------- */
  .contacto { margin-top: 200px; background: var(--c-superficie); }
  .contacto__interior {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: center;
    min-height: 80svh; padding-block: 96px;
  }
  .contacto__hora { display: flex; flex-direction: column; gap: 8px; }
  .contacto__reloj {
    font-family: var(--f-titulo); font-size: var(--t-nombre); font-weight: 300; letter-spacing: -0.04em; line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .contacto__lugar { font-size: var(--t-entrada); color: var(--c-suave); }
  .contacto__tarjeta { display: flex; flex-direction: column; gap: 20px; padding: 32px; background: var(--c-fondo); }
  .contacto__titulo { font-family: var(--f-titulo); font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); letter-spacing: -0.025em; line-height: 1; }
  .contacto__respuesta { color: var(--c-suave); font-size: var(--t-pequeno); }
  .contacto__canales { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .contacto__canales li { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; }
  .contacto__canales a { color: var(--c-texto); text-underline-offset: 4px; text-decoration-color: var(--c-punto-inactivo); }
  .contacto__canales a:hover { text-decoration-color: currentColor; }
  .contacto__copiar { min-height: 44px; padding: 0 12px; border: 0; background: var(--c-superficie-2); color: var(--c-texto); font-size: var(--t-pequeno); cursor: pointer; }
  .contacto__copiar:hover { background: var(--c-texto); color: var(--c-fondo); }
  .contacto__boton { align-self: stretch; min-height: 52px; }

  /* ---------- Movimiento ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* Zoom lento en la foto. */
    .hero__foto img { animation: respirar 22s ease-in-out infinite alternate; }
    @keyframes respirar { from { transform: scale(1); } to { transform: scale(1.05); } }

    /* El nombre entra subiendo y, al bajar, crece y sube (animación principal). */
    .hero__nombre span { animation: nombre-entra 1200ms var(--ease-salida) 200ms both; }
    @keyframes nombre-entra { from { opacity: 0; transform: translateY(30%); } to { opacity: 1; transform: none; } }
    @supports (animation-timeline: scroll()) {
      .hero__nombre { animation: nombre-escala linear both; animation-timeline: scroll(root); animation-range: 0 70svh; transform-origin: left bottom; }
      @keyframes nombre-escala { to { transform: translateY(-12svh) scale(1.18); } }
      .hero__foto { animation: foto-baja linear both; animation-timeline: scroll(root); animation-range: 0 90svh; }
      @keyframes foto-baja { to { opacity: 0.35; } }
    }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1040px) {
    .hero { grid-template-columns: 50% minmax(0, 1fr); }
    .hero__nombre { left: 30vw; font-size: clamp(4rem, 10vw, 6rem); }
    .hero__texto { margin-top: 22svh; }
    .trabajo__cabeza, .trabajo__cuerpo { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .contacto__interior { grid-template-columns: 1fr; }
  }

  /* ---------- Teléfono ---------- */
  @media (max-width: 760px) {
    .hero { display: flex; flex-direction: column; height: auto; min-height: 0; max-height: none; padding: 12px 12px 0; }
    .hero__foto { height: 58svh; }
    .hero__nombre {
      position: relative; left: auto; right: auto; bottom: auto; margin-top: -3.4vw; padding: 0 8px;
      font-size: 15.5vw; line-height: 0.9;
    }
    .hero__texto { order: 3; margin: 24px 0 0; max-width: none; padding: 0 8px; gap: 24px; justify-self: stretch; }
    .hero__frase { font-size: 1.0625rem; line-height: 1.5; }
    .hero__acciones .btn { flex: 1; }

    .trabajo { padding-top: 120px; gap: 32px; }
    .trabajo__cabeza, .trabajo__cuerpo { grid-template-columns: 1fr; gap: 16px; }
    .trabajo__vista { display: none; }
    .trabajo__vista-movil { display: block; margin-bottom: 24px; }
    .trabajo__enlace { padding: 12px 0; }
    .trabajo__lista:hover .trabajo__enlace:not(:hover) .trabajo__nombre { color: var(--c-texto); }

    .sobre { padding-top: 120px; grid-template-columns: 1fr; gap: 40px; }
    .sobre__datos { order: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; padding-top: 0; }
    .sobre__parrafo { font-size: 1.1875rem; }

    .contacto { margin-top: 120px; }
    .contacto__interior { min-height: 0; padding-block: 64px; gap: 40px; }
    .contacto__reloj { font-size: 22vw; }
    .contacto__tarjeta { padding: 24px 20px; }
    .contacto__canales a { overflow-wrap: anywhere; }
  }
</style>
