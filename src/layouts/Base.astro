---
import '@/styles/global.css';
import Header, { type Seccion } from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { localeDe, otroIdioma, ruta, rutaSinIdioma, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
  titulo?: string;
  descripcion?: string;
  seccion?: Seccion;
  /** Ruta equivalente sin prefijo de idioma (por defecto, la actual). */
  rutaAlterna?: string;
  /** false si la página no existe en el otro idioma. */
  tieneAlterna?: boolean;
  imagen?: string;
  tipo?: 'website' | 'article';
  publicado?: Date;
  noindex?: boolean;
}

const {
  lang,
  titulo,
  descripcion,
  seccion = 'ninguna',
  rutaAlterna,
  tieneAlterna = true,
  imagen = '/og.png',
  tipo = 'website',
  publicado,
  noindex = false,
} = Astro.props;

const t = useT(lang);
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · ${lang === 'es' ? 'Portafolio' : 'Portfolio'}`;
const desc = descripcion ?? t('meta.descripcion');
const base = rutaAlterna ?? rutaSinIdioma(Astro.url.pathname);
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const otro = otroIdioma(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonica} />
    {
      tieneAlterna && (
        <>
          <link rel="alternate" hreflang={lang} href={new URL(ruta(lang, base), Astro.site)} />
          <link rel="alternate" hreflang={otro} href={new URL(ruta(otro, base), Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(ruta('es', base), Astro.site)} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#161c1a" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo ?? sitio.nombre} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeDe(lang).replace('-', '_')} />
    <meta property="og:locale:alternate" content={localeDe(otro).replace('-', '_')} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo ?? sitio.nombre} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imagenAbs} />
    <noscript><style>[data-solo-js] { display: none !important; }</style></noscript>
  </head>
  <body>
    <div id="top">
      <a href="#contenido" class="saltar">{t('saltar')}</a>
      <Header lang={lang} actual={seccion} rutaAlterna={base} />
      <slot />
      <Footer lang={lang} rutaAlterna={base} />
    </div>
    <p id="anuncio" class="sr-only" aria-live="polite"></p>
    <script>
      import { iniciarCopiar } from '@/scripts/copiar';
      iniciarCopiar();
    </script>
  </body>
</html>
