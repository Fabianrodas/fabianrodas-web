---
import { ruta, rutaSinIdioma, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

export type Seccion = 'inicio' | 'proyectos' | 'sobre' | 'contacto' | 'ninguna';

interface Props {
  lang: Lang;
  actual: Seccion;
  /** Ruta equivalente en el otro idioma (sin prefijo). Por defecto, la misma ruta. */
  rutaAlterna?: string;
}

const { lang, actual, rutaAlterna } = Astro.props;
const t = useT(lang);
const base = rutaAlterna ?? rutaSinIdioma(Astro.url.pathname);

const enlaces = [
  { clave: 'inicio', label: t('nav.inicio'), href: ruta(lang, '/') },
  { clave: 'proyectos', label: t('nav.proyectos'), href: ruta(lang, '/proyectos/') },
  { clave: 'sobre', label: t('nav.sobre'), href: ruta(lang, '/sobre-mi/') },
  { clave: 'contacto', label: t('nav.contacto'), href: ruta(lang, '/contacto/') },
] as const;

const idiomasNav = [
  { code: 'es' as const, label: 'ES', href: ruta('es', base) },
  { code: 'en' as const, label: 'EN', href: ruta('en', base) },
];
---
<header class="cabecera" data-cabecera>
  <div class="cabecera__fila">
    <nav aria-label={t('nav.principal')} class="nav-principal">
      {enlaces.map((e) => (
        <a
          href={e.href}
          aria-current={actual === e.clave ? 'page' : undefined}
          class:list={['nav-principal__link', { activo: actual === e.clave, 'nav-principal__accion btn btn--acento': e.clave === 'contacto' }]}
        >
          {e.label}
        </a>
      ))}
    </nav>
    <a href={sitio.cv} class="cabecera__cv" download>{t('nav.cv')}</a>
    <nav aria-label={t('nav.idioma')} class="idiomas">
      {idiomasNav.map((i) => (
        <a
          href={i.href}
          lang={i.code}
          hreflang={i.code}
          aria-current={i.code === lang ? 'true' : undefined}
          class:list={['idiomas__link', { activo: i.code === lang }]}
          data-idioma={i.code}
        >
          {i.label}
        </a>
      ))}
    </nav>
    <button
      type="button"
      class="menu-boton"
      aria-label={t('nav.abrir')}
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-boton
      data-label-abrir={t('nav.abrir')}
      data-label-cerrar={t('nav.cerrar')}
    >
      <span class="menu-boton__abrir" aria-hidden="true">{t('nav.menu')}</span>
      <span class="menu-boton__cerrar" aria-hidden="true">{t('nav.cerrarCorto')}</span>
    </button>
    <a href={ruta(lang, '/contacto/')} class="btn btn--acento cabecera__accion-movil">{t('nav.contacto')}</a>
  </div>

  <div id="menu-movil" class="menu-movil" hidden data-menu>
    <nav aria-label={t('nav.menu')}>
      <ul>
        {enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={actual === e.clave ? 'page' : undefined} class:list={{ activo: actual === e.clave }}>
              {e.label}
            </a>
          </li>
        ))}
        <li><a href={sitio.cv} download>{t('pie.cv')}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function iniciarMenu() {
    const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!boton || !menu) return;
    const abrir = boton.dataset.labelAbrir ?? '';
    const cerrar = boton.dataset.labelCerrar ?? '';
    const fijar = (abierto: boolean) => {
      boton.setAttribute('aria-expanded', String(abierto));
      boton.setAttribute('aria-label', abierto ? cerrar : abrir);
      menu.hidden = !abierto;
      document.documentElement.classList.toggle('menu-abierto', abierto);
    };
    boton.addEventListener('click', () => fijar(boton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        fijar(false);
        boton.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) fijar(false);
    });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (m) => {
      if (m.matches) fijar(false);
    });
  }
  iniciarMenu();

</script>

<style>
  .cabecera {
    position: sticky; top: 0; z-index: 20; width: 100%;
    background: var(--c-fondo); color: var(--c-texto);
    font-size: 15px; line-height: 1.4;
  }
  .cabecera__fila {
    max-width: var(--contenedor); margin: 0 auto; padding: 16px var(--gutter);
    display: flex; align-items: center; justify-content: flex-end; gap: 28px;
  }
  .nav-principal { display: flex; align-items: center; gap: 28px; }
  .nav-principal__link {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--c-secundario); text-decoration: none;
  }
  .nav-principal__link:hover, .nav-principal__link.activo { color: var(--c-texto); }
  .nav-principal__link.activo:not(.nav-principal__accion) { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--c-acento); }
  .nav-principal__accion { order: 9; color: var(--c-acento-tinta); margin-left: 8px; }
  .cabecera__cv { display: inline-flex; align-items: center; min-height: 44px; color: var(--c-secundario); text-decoration: none; order: -1; }
  .cabecera__cv:hover { color: var(--c-texto); }
  .idiomas { display: flex; gap: 12px; order: -1; }
  .idiomas__link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 2px; color: var(--c-secundario); text-decoration: none; }
  .idiomas__link:hover, .idiomas__link.activo { color: var(--c-texto); }
  .nav-principal { order: 1; }

  .menu-boton {
    display: none; align-items: center; min-height: 44px; padding: 0 4px; border: 0;
    background: none; color: var(--c-texto); cursor: pointer; font-size: 15px;
  }
  .menu-boton__cerrar { display: none; }
  .menu-boton[aria-expanded='true'] .menu-boton__abrir { display: none; }
  .menu-boton[aria-expanded='true'] .menu-boton__cerrar { display: inline; }
  .cabecera__accion-movil { display: none; }

  .menu-movil { position: absolute; left: 0; right: 0; top: 100%; padding: 8px var(--gutter) 28px; background: var(--c-fondo); }
  .menu-movil[hidden] { display: none; }
  .menu-movil ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .menu-movil a { display: flex; align-items: center; min-height: 52px; color: var(--c-secundario); text-decoration: none; font-size: var(--t-entrada); }
  .menu-movil a.activo { color: var(--c-texto); }

  @media (max-width: 860px) {
    .cabecera__fila { justify-content: space-between; gap: 16px; padding-block: 12px; }
    .nav-principal, .cabecera__cv { display: none; }
    .menu-boton { display: inline-flex; order: -2; margin-right: auto; }
    .idiomas { order: 0; }
    .cabecera__accion-movil { display: inline-flex; order: 1; }
  }
</style>
