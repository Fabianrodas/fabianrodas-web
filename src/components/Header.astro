---
import Icono from './Icono.astro';
import { ruta, rutaSinIdioma, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

export type Seccion = 'inicio' | 'proyectos' | 'sobre' | 'contacto' | 'ninguna';

interface Props {
  lang: Lang;
  actual: Seccion;
  /** Ruta equivalente en el otro idioma (sin prefijo). Por defecto, la misma ruta. */
  rutaAlterna?: string;
}

const { lang, actual, rutaAlterna } = Astro.props;
const t = useT(lang);
const base = rutaAlterna ?? rutaSinIdioma(Astro.url.pathname);

const enlaces = [
  { clave: 'inicio', label: t('nav.inicio'), href: ruta(lang, '/') },
  { clave: 'proyectos', label: t('nav.proyectos'), href: ruta(lang, '/proyectos/') },
  { clave: 'sobre', label: t('nav.sobre'), href: ruta(lang, '/sobre-mi/') },
  { clave: 'contacto', label: t('nav.contacto'), href: ruta(lang, '/contacto/') },
] as const;

const idiomasNav = [
  { code: 'es' as const, label: 'ES', href: ruta('es', base) },
  { code: 'en' as const, label: 'EN', href: ruta('en', base) },
];
---
<header class="cabecera" data-cabecera>
  <div class="cabecera__fila">
    <a href={ruta(lang, '/')} class="marca" aria-label={t('nav.inicio')}>
      <span class="marca__avatar" aria-hidden="true">{sitio.iniciales}</span>
    </a>

    <nav aria-label={t('nav.principal')} class="nav-principal">
      {enlaces.map((e) => (
        <a href={e.href} aria-current={actual === e.clave ? 'page' : undefined} class:list={['nav-principal__link', { activo: actual === e.clave }]}>
          {e.label}
        </a>
      ))}
    </nav>

    <div class="cabecera__acciones">
      <nav aria-label={t('nav.idioma')} class="idiomas">
        {idiomasNav.map((i) => (
          <a
            href={i.href}
            lang={i.code}
            hreflang={i.code}
            aria-current={i.code === lang ? 'true' : undefined}
            class:list={['idiomas__link', { activo: i.code === lang }]}
            data-idioma={i.code}
          >
            {i.label}
          </a>
        ))}
      </nav>
      <a href={sitio.cv} class="cv" download>
        <Icono nombre="download" size={16} />{t('nav.cv')}
      </a>
      <button
        type="button"
        class="menu-boton"
        aria-label={t('nav.abrir')}
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-boton
        data-label-abrir={t('nav.abrir')}
        data-label-cerrar={t('nav.cerrar')}
      >
        <Icono nombre="menu" class="menu-boton__abrir" />
        <Icono nombre="x" class="menu-boton__cerrar" />
      </button>
    </div>
  </div>

  <div id="menu-movil" class="menu-movil" hidden data-menu>
    <nav aria-label={t('nav.menu')}>
      <ul>
        {enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={actual === e.clave ? 'page' : undefined} class:list={{ activo: actual === e.clave }}>
              {e.label}
            </a>
          </li>
        ))}
        <li>
          <a href={sitio.cv} download><Icono nombre="download" size={16} />{t('pie.cv')}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function iniciarMenu() {
    const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!boton || !menu) return;
    const abrir = boton.dataset.labelAbrir ?? '';
    const cerrar = boton.dataset.labelCerrar ?? '';
    const fijar = (abierto: boolean) => {
      boton.setAttribute('aria-expanded', String(abierto));
      boton.setAttribute('aria-label', abierto ? cerrar : abrir);
      menu.hidden = !abierto;
      document.documentElement.classList.toggle('menu-abierto', abierto);
    };
    boton.addEventListener('click', () => fijar(boton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        fijar(false);
        boton.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) fijar(false);
    });
    window.matchMedia('(min-width: 1041px)').addEventListener('change', (m) => {
      if (m.matches) fijar(false);
    });
  }
  iniciarMenu();

  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]');
  const marcar = () => cabecera?.toggleAttribute('data-desplazada', window.scrollY > 8);
  window.addEventListener('scroll', marcar, { passive: true });
  marcar();
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    background: rgb(22 28 26 / 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms, background-color 200ms;
    color: var(--c-texto);
    font-size: 15px;
    line-height: 1.4;
  }
  .cabecera[data-desplazada] { border-bottom-color: var(--c-borde); background: rgb(22 28 26 / 0.86); }
  .cabecera__fila {
    max-width: var(--contenedor);
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .marca { display: flex; align-items: center; gap: 12px; color: var(--c-texto); text-decoration: none; }
  .marca { border-radius: 50%; }
  .marca:hover .marca__avatar { background: var(--c-acento); color: var(--c-fondo); }
  .marca__avatar {
    transition: background-color 200ms, color 200ms;
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--c-superficie-2); color: var(--c-acento);
    font-family: var(--f-titulo); font-size: 15px; font-weight: 600;
  }

  .nav-principal { display: flex; gap: 2px; padding: 4px; border-radius: var(--r-pildora); background: var(--c-superficie); }
  .nav-principal__link {
    display: inline-flex; align-items: center; height: 38px; padding: 0 16px;
    border-radius: var(--r-pildora); text-decoration: none; color: var(--c-secundario);
  }
  .nav-principal__link:hover { color: var(--c-texto); }
  .nav-principal__link.activo { background: var(--c-superficie-2); color: var(--c-texto); }

  .cabecera__acciones { display: flex; align-items: center; gap: 10px; }
  .idiomas { display: flex; gap: 2px; padding: 4px; border-radius: var(--r-pildora); background: var(--c-superficie); font-size: 13px; }
  .idiomas__link {
    display: inline-flex; align-items: center; height: 32px; padding: 0 12px;
    border-radius: var(--r-pildora); color: var(--c-secundario); text-decoration: none;
  }
  .idiomas__link:hover { color: var(--c-texto); }
  .idiomas__link.activo { background: var(--c-superficie-2); color: var(--c-texto); }
  .cv {
    display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px;
    border-radius: var(--r-pildora); background: var(--c-superficie-2); color: var(--c-texto); text-decoration: none;
  }

  .menu-boton {
    display: none; align-items: center; justify-content: center;
    width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: var(--c-superficie); color: var(--c-texto); cursor: pointer;
  }
  .menu-boton :global(.menu-boton__cerrar) { display: none; }
  .menu-boton[aria-expanded='true'] :global(.menu-boton__abrir) { display: none; }
  .menu-boton[aria-expanded='true'] :global(.menu-boton__cerrar) { display: block; }

  .menu-movil {
    position: absolute; left: 0; right: 0; top: 100%;
    padding: 0 20px 24px; background: var(--c-fondo);
    box-shadow: 0 24px 40px rgb(0 0 0 / 0.35);
  }
  .menu-movil[hidden] { display: none; }
  .menu-movil ul {
    list-style: none; margin: 0; padding: 8px; display: flex; flex-direction: column; gap: 2px;
    border-radius: var(--r-card); background: var(--c-superficie);
  }
  .menu-movil a {
    display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 14px;
    border-radius: 12px; color: var(--c-suave); text-decoration: none; font-size: 16px;
  }
  .menu-movil a.activo { background: var(--c-superficie-2); color: var(--c-texto); }

  @media (max-width: 1040px) {
    .cabecera__fila { padding: 16px 20px; }
    .nav-principal, .cv { display: none; }
    .menu-boton { display: inline-flex; }
    .cabecera__acciones { gap: 8px; }
    .marca { gap: 10px; }
    .marca__avatar { width: 38px; height: 38px; font-size: 14px; }
    .idiomas { padding: 3px; }
    .idiomas__link { height: 38px; padding: 0 10px; }
  }
</style>
