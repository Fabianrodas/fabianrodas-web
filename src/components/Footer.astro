---
import { otroIdioma, ruta, rutaSinIdioma, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';

interface Props {
  lang: Lang;
  rutaAlterna?: string;
}

const { lang, rutaAlterna } = Astro.props;
const t = useT(lang);
const otro = otroIdioma(lang);
const base = rutaAlterna ?? rutaSinIdioma(Astro.url.pathname);

---
<footer class="pie">
  <div class="pie__fila">
    <p class="pie__que">{t('pie.que')}</p>
    <ul class="pie__enlaces">
      <li><a href={sitio.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={sitio.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={`mailto:${sitio.email}`}>{t('pie.email')}</a></li>
      <li><a href={sitio.cv} download>{t('pie.cv')}</a></li>
      <li><a href={ruta(otro, base)} lang={otro} hreflang={otro}>{t('pie.otroIdioma')}</a></li>
    </ul>
    <p class="pie__fin"><span>© 2026</span><a href="#top">{t('pie.arriba')}</a></p>
  </div>
</footer>

<style>
  .pie { width: 100%; padding-top: 30svh; color: var(--c-secundario); font-size: 15px; line-height: 1.5; }
  .pie__fila {
    max-width: var(--contenedor); margin: 0 auto; padding: 0 var(--gutter) 30px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
  }
  .pie__enlaces { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 24px; }
  .pie a { color: var(--c-texto); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
  .pie a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .pie__fin { display: flex; justify-content: flex-end; align-items: center; gap: 24px; }
  .pie__fila > p:first-child { display: flex; align-items: center; min-height: 44px; }
  @media (max-width: 860px) {
    .pie { padding-top: 20svh; }
    .pie__fila { grid-template-columns: 1fr; gap: 8px; padding-bottom: 24px; }
    .pie__enlaces { justify-content: flex-start; gap: 0 20px; }
    .pie__fin { justify-content: flex-start; }
  }
</style>
