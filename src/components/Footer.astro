---
import Icono from './Icono.astro';
import { otroIdioma, ruta, rutaSinIdioma, useT, type Lang } from '@/i18n/ui';
import { sitio } from '@/lib/sitio';
import { obtenerProyectos } from '@/lib/contenido';

interface Props {
  lang: Lang;
  rutaAlterna?: string;
}

const { lang, rutaAlterna } = Astro.props;
const t = useT(lang);
const otro = otroIdioma(lang);
const base = rutaAlterna ?? rutaSinIdioma(Astro.url.pathname);
const destacados = (await obtenerProyectos(lang)).filter((p) => p.data.featured);

const enlacesSitio = [
  { label: t('nav.inicio'), href: ruta(lang, '/') },
  { label: t('nav.proyectos'), href: ruta(lang, '/proyectos/') },
  { label: t('nav.sobre'), href: ruta(lang, '/sobre-mi/') },
  { label: t('nav.contacto'), href: ruta(lang, '/contacto/') },
];
---
<footer class="pie">
  <div class="pie__interior">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <div class="pie__id">
          <span class="pie__nombres">
            <span class="pie__nombre">{sitio.nombre}</span>
            <span class="pie__rol">{t('pie.rol')}</span>
          </span>
        </div>
        <p class="pie__bio">{t('pie.bio')}</p>
        <div class="pie__redes">
          <a href={sitio.github} rel="me noopener" target="_blank"><Icono nombre="github" size={18} />GitHub</a>
          <a href={sitio.linkedin} rel="me noopener" target="_blank"><Icono nombre="linkedin" size={18} />LinkedIn</a>
          <a href={`mailto:${sitio.email}`}><Icono nombre="mail" size={18} />Email</a>
        </div>
      </div>
      <div class="pie__columnas">
        <nav aria-label={t('pie.sitio')} class="pie__col">
          <h2>{t('pie.sitio')}</h2>
          {enlacesSitio.map((e) => <a href={e.href}>{e.label}</a>)}
        </nav>
        <nav aria-label={t('pie.proyectosDestacados')} class="pie__col pie__col--proyectos">
          <h2>{t('pie.proyectos')}</h2>
          {destacados.map((p) => <a href={ruta(lang, `/proyectos/${p.data.slug}/`)}>{p.data.title}</a>)}
        </nav>
        <div class="pie__col">
          <h2>{t('pie.mas')}</h2>
          <a href={sitio.cv} download>{t('pie.cv')}</a>
          <a href={ruta(otro, base)} lang={otro} hreflang={otro}>{t('pie.otroIdioma')}</a>
        </div>
      </div>
    </div>
    <div class="pie__legal">
      <span class="pie__copy-largo">{t('pie.copy')}</span>
      <span class="pie__copy-corto">{t('pie.copyCorto')}</span>
      <a href="#top">{t('pie.arriba')}</a>
    </div>
  </div>
</footer>

<style>
  .pie { width: 100%; margin-top: 24px; background: var(--c-pie); color: var(--c-texto); font-size: 1rem; line-height: 1.5; }
  .pie__interior {
    max-width: var(--contenedor); margin: 0 auto; padding: 80px var(--gutter) 32px;
    display: flex; flex-direction: column; gap: 64px;
  }
  .pie__rejilla { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; }
  .pie__marca { display: flex; flex-direction: column; gap: 20px; }
  .pie__nombres { display: flex; flex-direction: column; gap: 2px; }
  .pie__nombre { font-family: var(--f-titulo); font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.1; }
  .pie__rol { font-size: var(--t-pequeno); color: var(--c-secundario); }
  .pie__bio { max-width: 40ch; color: var(--c-suave); }
  .pie__redes { display: flex; flex-wrap: wrap; gap: 8px; }
  .pie__redes a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    background: var(--c-superficie); color: var(--c-texto); text-decoration: none; font-size: var(--t-pequeno);
  }
  .pie__redes a:hover { background: var(--c-texto); color: var(--c-fondo); }
  .pie__columnas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .pie__col { display: flex; flex-direction: column; gap: 4px; }
  .pie__col h2 { margin: 0 0 8px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .pie__col a { display: inline-flex; align-items: center; min-height: 36px; color: var(--c-texto); text-decoration: none; }
  .pie__col a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--c-acento); }
  .pie__legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: var(--t-pequeno); color: var(--c-secundario); }
  .pie__legal a { color: var(--c-texto); text-underline-offset: 4px; }
  .pie__copy-corto { display: none; }

  @media (max-width: 760px) {
    .pie__interior { padding: 56px var(--gutter) 28px; gap: 40px; }
    .pie__rejilla { grid-template-columns: 1fr; gap: 32px; }
    .pie__bio { display: none; }
    .pie__columnas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; }
    .pie__col--proyectos { display: none; }
    .pie__col a { min-height: 44px; }
    .pie__legal { flex-wrap: nowrap; }
    .pie__copy-largo { display: none; }
    .pie__copy-corto { display: inline; }
  }
</style>
