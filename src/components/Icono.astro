export type NombreIcono = keyof typeof iconos;

interface Props {
  nombre: NombreIcono;
  size?: number;
  stroke?: string;
  grosor?: number;
  class?: string;
  style?: string;
}

const { nombre, size = 18, stroke = 'currentColor', grosor = 1.8, class: clase, style } = Astro.props;
const esFlecha = nombre === 'arrow-right';
---
<svg
  width={esFlecha ? 28 : size}
  height={esFlecha ? 16 : size}
  viewBox={esFlecha ? '0 0 28 16' : '0 0 24 24'}
  fill="none"
  stroke={stroke}
  stroke-width={grosor}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={clase}
  style={style}
  set:html={iconos[nombre]}
/>
