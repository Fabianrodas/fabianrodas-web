---
// Figura con captura de teléfono y texto al lado, para usar dentro de una nota MDX:
// <Figura kind="lumen-movil" titulo="…" texto="…" />  (o src="/img/captura.png" para una imagen real)
import Shot, { type TipoShot } from '@/components/Shot.astro';

interface Props {
  kind?: TipoShot;
  src?: string;
  alt?: string;
  titulo: string;
  texto?: string;
  ratio?: string;
}
const { kind = 'lumen-movil', src, alt, titulo, texto, ratio = '9 / 19' } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'es';
---
<figure class="figura">
  <div class="figura__imagen"><Shot kind={kind} src={src} alt={alt} ratio={ratio} radius="18px" lang={lang} /></div>
  <figcaption class="figura__texto">
    <span class="figura__titulo">{titulo}</span>
    {texto && <span class="figura__desc">{texto}</span>}
  </figcaption>
</figure>

<style>
  .figura {
    margin: 8px 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 16px; align-items: center;
    padding: 20px; border-radius: var(--r-m); background: var(--c-superficie);
  }
  .figura__imagen { padding: 0 18px; }
  .figura__texto { display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.6; }
  .figura__titulo { color: var(--c-texto); font-weight: 500; }
  .figura__desc { color: var(--c-secundario); }
  @media (max-width: 560px) {
    .figura { grid-template-columns: 1fr; padding: 16px; }
    .figura__imagen { padding: 0 25%; }
  }
</style>
