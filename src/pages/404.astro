---
import Base from '@/layouts/Base.astro';
---
<Base lang="es" titulo="Página no encontrada" descripcion="Esta página no existe o cambió de lugar." noindex tieneAlterna={false} rutaAlterna="/">
  <main id="contenido" class="contenedor error">
    <section class="error__caja entrada" aria-labelledby="error-title">
      <p class="error__codigo" aria-hidden="true">404</p>
      <h1 id="error-title" class="h1-pagina">Esta página no existe</h1>
      <p class="error__texto">Puede que el enlace esté roto o que la página haya cambiado de lugar.</p>
      <p class="error__texto" lang="en">This page doesn't exist. The link may be broken or the page may have moved.</p>
      <div class="error__botones">
        <a href="/" class="btn btn--acento">Ir al inicio</a>
        <a href="/proyectos/" class="enlace">Ver proyectos</a>
        <a href="/en/" class="enlace" lang="en" hreflang="en">English home</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .error { padding: 72px var(--gutter) 144px; }
  .error__caja { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; max-width: 900px; }
  .error__codigo { font-size: var(--t-nombre); line-height: 0.9; letter-spacing: -0.04em; color: var(--c-acento); }
  .error__caja :global(.h1-pagina) { font-size: var(--t-titulo); line-height: 1; letter-spacing: -0.03em; }
  .error__texto { font-size: var(--t-entrada); line-height: 1.35; color: var(--c-suave); }
  .error__botones { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; padding-top: 8px; }
  @media (max-width: 760px) {
    .error { padding: 32px var(--gutter) 72px; }
  }
</style>
