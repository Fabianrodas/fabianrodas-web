---
import NotaDetalle from '@/views/NotaDetalle.astro';
import { obtenerNotas, slugNota } from '@/lib/contenido';

export async function getStaticPaths() {
  const notas = await obtenerNotas('en');
  return notas.map((n) => ({ params: { slug: slugNota(n) }, props: { nota: n } }));
}
const { nota } = Astro.props;
---
<NotaDetalle lang="en" nota={nota} />
